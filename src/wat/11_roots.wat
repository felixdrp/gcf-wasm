;; SPDX-License-Identifier: Apache-2.0
;; Copyright 2026 felixdrp
;;
;; 11_roots.wat — SHA-256, gcf-pack-root-v1 (SPEC §10.2, §10a.3) and the
;; consumer side of deltas: verify, decode + apply (generic) and atomic
;; graph delta application (SPEC §10.4, §10a.5). Mirrors gcf.zig section 9.

;; SHA-256 state: +0 8 words, +32 total length (i64), +40 buffer fill,
;; +64 64-byte block buffer. Message schedule: 64 words at $SHA_W.
(global $SHA i32 (i32.const 0x7E00))
(global $SHA_W i32 (i32.const 0x7E80))

(func $bswap (param $x i32) (result i32)
  (i32.or (i32.and (i32.rotl (local.get $x) (i32.const 8)) (i32.const 0x00FF00FF))
          (i32.and (i32.rotr (local.get $x) (i32.const 8)) (i32.const 0xFF00FF00))))

(func $sha_init
  (i32.store offset=0 (global.get $SHA) (i32.const 0x6a09e667))
  (i32.store offset=4 (global.get $SHA) (i32.const 0xbb67ae85))
  (i32.store offset=8 (global.get $SHA) (i32.const 0x3c6ef372))
  (i32.store offset=12 (global.get $SHA) (i32.const 0xa54ff53a))
  (i32.store offset=16 (global.get $SHA) (i32.const 0x510e527f))
  (i32.store offset=20 (global.get $SHA) (i32.const 0x9b05688c))
  (i32.store offset=24 (global.get $SHA) (i32.const 0x1f83d9ab))
  (i32.store offset=28 (global.get $SHA) (i32.const 0x5be0cd19))
  (i64.store offset=32 (global.get $SHA) (i64.const 0))
  (i32.store offset=40 (global.get $SHA) (i32.const 0)))

;; Compress one 64-byte block at p.
(func $sha_block (param $p i32)
  (local $t i32) (local $w i32) (local $x i32) (local $y i32)
  (local $a i32) (local $b i32) (local $c i32) (local $d i32) (local $e i32) (local $f i32) (local $g i32) (local $h i32)
  (local $t1 i32) (local $t2 i32)
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $t) (i32.const 16)))
    (i32.store (i32.add (global.get $SHA_W) (i32.shl (local.get $t) (i32.const 2)))
      (call $bswap (i32.load (i32.add (local.get $p) (i32.shl (local.get $t) (i32.const 2))))))
    (local.set $t (i32.add (local.get $t) (i32.const 1)))
    (br $l)))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $t) (i32.const 64)))
    (local.set $w (i32.add (global.get $SHA_W) (i32.shl (local.get $t) (i32.const 2))))
    (local.set $x (i32.load (i32.sub (local.get $w) (i32.const 60))))  ;; W[t-15]
    (local.set $y (i32.load (i32.sub (local.get $w) (i32.const 8))))   ;; W[t-2]
    (i32.store (local.get $w)
      (i32.add (i32.add (i32.load (i32.sub (local.get $w) (i32.const 64)))   ;; W[t-16]
                        (i32.xor (i32.xor (i32.rotr (local.get $x) (i32.const 7)) (i32.rotr (local.get $x) (i32.const 18))) (i32.shr_u (local.get $x) (i32.const 3))))
               (i32.add (i32.load (i32.sub (local.get $w) (i32.const 28)))   ;; W[t-7]
                        (i32.xor (i32.xor (i32.rotr (local.get $y) (i32.const 17)) (i32.rotr (local.get $y) (i32.const 19))) (i32.shr_u (local.get $y) (i32.const 10))))))
    (local.set $t (i32.add (local.get $t) (i32.const 1)))
    (br $l)))
  (local.set $a (i32.load offset=0 (global.get $SHA))) (local.set $b (i32.load offset=4 (global.get $SHA)))
  (local.set $c (i32.load offset=8 (global.get $SHA))) (local.set $d (i32.load offset=12 (global.get $SHA)))
  (local.set $e (i32.load offset=16 (global.get $SHA))) (local.set $f (i32.load offset=20 (global.get $SHA)))
  (local.set $g (i32.load offset=24 (global.get $SHA))) (local.set $h (i32.load offset=28 (global.get $SHA)))
  (local.set $t (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $t) (i32.const 64)))
    (local.set $t1 (i32.add (i32.add (i32.add (local.get $h)
        (i32.xor (i32.xor (i32.rotr (local.get $e) (i32.const 6)) (i32.rotr (local.get $e) (i32.const 11))) (i32.rotr (local.get $e) (i32.const 25))))
        (i32.xor (i32.and (local.get $e) (local.get $f)) (i32.and (i32.xor (local.get $e) (i32.const -1)) (local.get $g))))
      (i32.add (i32.load (i32.add (i32.const 0x7D00) (i32.shl (local.get $t) (i32.const 2))))
               (i32.load (i32.add (global.get $SHA_W) (i32.shl (local.get $t) (i32.const 2)))))))
    (local.set $t2 (i32.add
      (i32.xor (i32.xor (i32.rotr (local.get $a) (i32.const 2)) (i32.rotr (local.get $a) (i32.const 13))) (i32.rotr (local.get $a) (i32.const 22)))
      (i32.xor (i32.xor (i32.and (local.get $a) (local.get $b)) (i32.and (local.get $a) (local.get $c))) (i32.and (local.get $b) (local.get $c)))))
    (local.set $h (local.get $g)) (local.set $g (local.get $f)) (local.set $f (local.get $e))
    (local.set $e (i32.add (local.get $d) (local.get $t1)))
    (local.set $d (local.get $c)) (local.set $c (local.get $b)) (local.set $b (local.get $a))
    (local.set $a (i32.add (local.get $t1) (local.get $t2)))
    (local.set $t (i32.add (local.get $t) (i32.const 1)))
    (br $l)))
  (i32.store offset=0 (global.get $SHA) (i32.add (i32.load offset=0 (global.get $SHA)) (local.get $a)))
  (i32.store offset=4 (global.get $SHA) (i32.add (i32.load offset=4 (global.get $SHA)) (local.get $b)))
  (i32.store offset=8 (global.get $SHA) (i32.add (i32.load offset=8 (global.get $SHA)) (local.get $c)))
  (i32.store offset=12 (global.get $SHA) (i32.add (i32.load offset=12 (global.get $SHA)) (local.get $d)))
  (i32.store offset=16 (global.get $SHA) (i32.add (i32.load offset=16 (global.get $SHA)) (local.get $e)))
  (i32.store offset=20 (global.get $SHA) (i32.add (i32.load offset=20 (global.get $SHA)) (local.get $f)))
  (i32.store offset=24 (global.get $SHA) (i32.add (i32.load offset=24 (global.get $SHA)) (local.get $g)))
  (i32.store offset=28 (global.get $SHA) (i32.add (i32.load offset=28 (global.get $SHA)) (local.get $h))))

(func $sha_update (param $p i32) (param $n i32)
  (local $fill i32) (local $take i32) (local $buf i32)
  (local.set $buf (i32.add (global.get $SHA) (i32.const 64)))
  (i64.store offset=32 (global.get $SHA) (i64.add (i64.load offset=32 (global.get $SHA)) (i64.extend_i32_u (local.get $n))))
  (local.set $fill (i32.load offset=40 (global.get $SHA)))
  (if (local.get $fill)
    (then
      (local.set $take (select (i32.sub (i32.const 64) (local.get $fill)) (local.get $n) (i32.lt_u (i32.sub (i32.const 64) (local.get $fill)) (local.get $n))))
      (memory.copy (i32.add (local.get $buf) (local.get $fill)) (local.get $p) (local.get $take))
      (local.set $fill (i32.add (local.get $fill) (local.get $take)))
      (local.set $p (i32.add (local.get $p) (local.get $take)))
      (local.set $n (i32.sub (local.get $n) (local.get $take)))
      (if (i32.eq (local.get $fill) (i32.const 64)) (then (call $sha_block (local.get $buf)) (local.set $fill (i32.const 0))))))
  (block $done (loop $l
    (br_if $done (i32.lt_u (local.get $n) (i32.const 64)))
    (call $sha_block (local.get $p))
    (local.set $p (i32.add (local.get $p) (i32.const 64)))
    (local.set $n (i32.sub (local.get $n) (i32.const 64)))
    (br $l)))
  (if (local.get $n)
    (then
      (memory.copy (i32.add (local.get $buf) (local.get $fill)) (local.get $p) (local.get $n))
      (local.set $fill (i32.add (local.get $fill) (local.get $n)))))
  (i32.store offset=40 (global.get $SHA) (local.get $fill)))

;; Finish; returns "sha256:<64 hex>" in the arena.
(func $sha_final_hex (result i32 i32)
  (local $fill i32) (local $buf i32) (local $bits i64) (local $out i32) (local $i i32) (local $b i32)
  (local.set $buf (i32.add (global.get $SHA) (i32.const 64)))
  (local.set $bits (i64.shl (i64.load offset=32 (global.get $SHA)) (i64.const 3)))
  (local.set $fill (i32.load offset=40 (global.get $SHA)))
  (i32.store8 (i32.add (local.get $buf) (local.get $fill)) (i32.const 0x80))
  (local.set $fill (i32.add (local.get $fill) (i32.const 1)))
  (if (i32.gt_u (local.get $fill) (i32.const 56))
    (then
      (memory.fill (i32.add (local.get $buf) (local.get $fill)) (i32.const 0) (i32.sub (i32.const 64) (local.get $fill)))
      (call $sha_block (local.get $buf))
      (local.set $fill (i32.const 0))))
  (memory.fill (i32.add (local.get $buf) (local.get $fill)) (i32.const 0) (i32.sub (i32.const 56) (local.get $fill)))
  (i32.store offset=56 (local.get $buf) (call $bswap (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32)))))
  (i32.store offset=60 (local.get $buf) (call $bswap (i32.wrap_i64 (local.get $bits))))
  (call $sha_block (local.get $buf))
  (local.set $out (call $alloc (i32.const 71)))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (memory.copy (local.get $out) (global.get $K_sha256) (i32.const 7))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (i32.const 32)))
    (local.set $b (i32.load8_u (i32.add (global.get $SHA) (i32.xor (local.get $i) (i32.const 3)))))  ;; big-endian byte of the state words
    (i32.store8 (i32.add (local.get $out) (i32.add (i32.const 7) (i32.shl (local.get $i) (i32.const 1))))
      (i32.load8_u (i32.add (global.get $K_hex) (i32.shr_u (local.get $b) (i32.const 4)))))
    (i32.store8 (i32.add (local.get $out) (i32.add (i32.const 8) (i32.shl (local.get $i) (i32.const 1))))
      (i32.load8_u (i32.add (global.get $K_hex) (i32.and (local.get $b) (i32.const 15)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $out) (i32.const 71))

;; ---------------------------------------------------------------------------
;; Sorting: stable bottom-up merge sort of `size`-byte elements whose key is
;; the (ptr, len) pair at offset 0, in unsigned byte order.
;; ---------------------------------------------------------------------------

(func $sort_by_key (param $base i32) (param $n i32) (param $size i32)
  (call $sort_records (local.get $base) (local.get $n) (local.get $size) (i32.const 0)))

;; Record comparison (<0, 0, >0). kind 0: (ptr, len) key at offset 0, byte
;; order. kind 1: graph symbols (distance i64 asc, score f64 desc, input
;; order asc). kind 2: resolved edges (source id, target id, type bytes,
;; input order).
(func $rec_cmp (param $kind i32) (param $x i32) (param $y i32) (result i32)
  (local $c i32)
  (if (i32.eqz (local.get $kind))
    (then (return (call $str_cmp (i32.load (local.get $x)) (i32.load offset=4 (local.get $x)) (i32.load (local.get $y)) (i32.load offset=4 (local.get $y))))))
  (if (i32.eq (local.get $kind) (i32.const 1))
    (then
      (if (i64.ne (i64.load (local.get $x)) (i64.load (local.get $y)))
        (then (return (select (i32.const -1) (i32.const 1) (i64.lt_s (i64.load (local.get $x)) (i64.load (local.get $y)))))))
      (if (f64.ne (f64.load offset=8 (local.get $x)) (f64.load offset=8 (local.get $y)))
        (then (return (select (i32.const -1) (i32.const 1) (f64.gt (f64.load offset=8 (local.get $x)) (f64.load offset=8 (local.get $y)))))))
      (return (i32.sub (i32.load offset=16 (local.get $x)) (i32.load offset=16 (local.get $y))))))
  (if (i64.ne (i64.load (local.get $x)) (i64.load (local.get $y)))
    (then (return (select (i32.const -1) (i32.const 1) (i64.lt_u (i64.load (local.get $x)) (i64.load (local.get $y)))))))
  (if (i64.ne (i64.load offset=8 (local.get $x)) (i64.load offset=8 (local.get $y)))
    (then (return (select (i32.const -1) (i32.const 1) (i64.lt_u (i64.load offset=8 (local.get $x)) (i64.load offset=8 (local.get $y)))))))
  (local.set $c (call $str_cmp (i32.load offset=16 (local.get $x)) (i32.load offset=20 (local.get $x)) (i32.load offset=16 (local.get $y)) (i32.load offset=20 (local.get $y))))
  (if (local.get $c) (then (return (local.get $c))))
  (i32.sub (i32.load offset=24 (local.get $x)) (i32.load offset=24 (local.get $y))))

;; Stable merge sort of n `size`-byte records by `kind`. The merge passes
;; move 4-byte pointers (plain loads and stores; a memory.copy call per
;; record dominated); the records are gathered into sorted order at the end.
(func $sort_records (param $base i32) (param $n i32) (param $size i32) (param $kind i32)
  (local $a i32) (local $b i32) (local $src i32) (local $dst i32) (local $w i32) (local $lo i32) (local $mid i32) (local $hi i32)
  (local $i i32) (local $j i32) (local $k i32) (local $x i32) (local $y i32) (local $t i32) (local $tmp i32)
  (if (i32.lt_u (local.get $n) (i32.const 2)) (then (return)))
  (local.set $a (call $alloc (i32.shl (local.get $n) (i32.const 2))))
  (local.set $b (call $alloc (i32.shl (local.get $n) (i32.const 2))))
  (if (global.get $err) (then (return)))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (i32.store (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2))) (i32.add (local.get $base) (i32.mul (local.get $i) (local.get $size))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.set $src (local.get $a))
  (local.set $dst (local.get $b))
  (local.set $w (i32.const 1))
  (block $wd (loop $wl
    (br_if $wd (i32.ge_u (local.get $w) (local.get $n)))
    (local.set $lo (i32.const 0))
    (block $ld (loop $ll
      (br_if $ld (i32.ge_u (local.get $lo) (local.get $n)))
      (local.set $mid (select (i32.add (local.get $lo) (local.get $w)) (local.get $n) (i32.lt_u (i32.add (local.get $lo) (local.get $w)) (local.get $n))))
      (local.set $hi (select (i32.add (local.get $mid) (local.get $w)) (local.get $n) (i32.lt_u (i32.add (local.get $mid) (local.get $w)) (local.get $n))))
      (local.set $i (local.get $lo)) (local.set $j (local.get $mid)) (local.set $k (local.get $lo))
      ;; runs already in order (common for near-sorted input): one block copy
      (if (i32.lt_u (local.get $mid) (local.get $hi))
        (then (if (i32.le_s (call $rec_cmp (local.get $kind)
                                (i32.load (i32.add (local.get $src) (i32.shl (i32.sub (local.get $mid) (i32.const 1)) (i32.const 2))))
                                (i32.load (i32.add (local.get $src) (i32.shl (local.get $mid) (i32.const 2)))))
                              (i32.const 0))
          (then (local.set $k (local.get $hi))))))
      (if (i32.ge_u (local.get $k) (local.get $hi))
        (then (memory.copy (i32.add (local.get $dst) (i32.shl (local.get $lo) (i32.const 2)))
                           (i32.add (local.get $src) (i32.shl (local.get $lo) (i32.const 2)))
                           (i32.shl (i32.sub (local.get $hi) (local.get $lo)) (i32.const 2)))))
      (block $md (loop $ml
        (br_if $md (i32.ge_u (local.get $k) (local.get $hi)))
        ;; take from the left run unless it is exhausted or the right one is
        ;; strictly smaller (control flow, not i32.and/or: both operands of
        ;; those are evaluated, and an exhausted run's element is out of range)
        (if (if (result i32) (i32.ge_u (local.get $j) (local.get $hi))
              (then (i32.const 1))
              (else (if (result i32) (i32.ge_u (local.get $i) (local.get $mid))
                (then (i32.const 0))
                (else
                  (local.set $x (i32.load (i32.add (local.get $src) (i32.shl (local.get $i) (i32.const 2)))))
                  (local.set $y (i32.load (i32.add (local.get $src) (i32.shl (local.get $j) (i32.const 2)))))
                  ;; kinds 1 and 2 lead with a 64-bit key (distance; packed
                  ;; source:target): decided inline, the call only on ties
                  (if (result i32) (i32.and (i32.ne (local.get $kind) (i32.const 0)) (i64.ne (i64.load (local.get $x)) (i64.load (local.get $y))))
                    (then (if (result i32) (i32.eq (local.get $kind) (i32.const 1))
                      (then (i64.lt_s (i64.load (local.get $x)) (i64.load (local.get $y))))
                      (else (i64.lt_u (i64.load (local.get $x)) (i64.load (local.get $y))))))
                    (else (i32.le_s (call $rec_cmp (local.get $kind) (local.get $x) (local.get $y)) (i32.const 0))))))))
          (then
            (i32.store (i32.add (local.get $dst) (i32.shl (local.get $k) (i32.const 2))) (i32.load (i32.add (local.get $src) (i32.shl (local.get $i) (i32.const 2)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1))))
          (else
            (i32.store (i32.add (local.get $dst) (i32.shl (local.get $k) (i32.const 2))) (i32.load (i32.add (local.get $src) (i32.shl (local.get $j) (i32.const 2)))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $ml)))
      (local.set $lo (local.get $hi))
      (br $ll)))
    (local.set $t (local.get $src)) (local.set $src (local.get $dst)) (local.set $dst (local.get $t))
    (local.set $w (i32.shl (local.get $w) (i32.const 1)))
    (br $wl)))
  ;; gather into a scratch copy in sorted order, then copy back in one block
  (local.set $tmp (call $alloc (i32.mul (local.get $n) (local.get $size))))
  (if (global.get $err) (then (return)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $x (i32.load (i32.add (local.get $src) (i32.shl (local.get $i) (i32.const 2)))))
    (local.set $y (i32.add (local.get $tmp) (i32.mul (local.get $i) (local.get $size))))
    ;; record sizes are multiples of 4: word moves, no memory.copy call
    (local.set $k (i32.const 0))
    (block $cd (loop $cl
      (br_if $cd (i32.ge_u (local.get $k) (local.get $size)))
      (i32.store (i32.add (local.get $y) (local.get $k)) (i32.load (i32.add (local.get $x) (local.get $k))))
      (local.set $k (i32.add (local.get $k) (i32.const 4)))
      (br $cl)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (memory.copy (local.get $base) (local.get $tmp) (i32.mul (local.get $n) (local.get $size))))

;; ---------------------------------------------------------------------------
;; Records (built at the output cursor, copied to the arena, rewound)
;; ---------------------------------------------------------------------------

(func $rec_begin (result i32)
  (local $off i32)
  ;; publish a cursor in progress, so the record starts where output ends
  (call $w_sync)
  (local.set $off (call $stack_len (global.get $STK_OUT)))
  (call $w_begin (i32.const 0))
  (local.get $off))

(func $rec_end (param $off i32) (result i32 i32)
  (local $n i32) (local $p i32)
  (call $w_sync)
  (local.set $n (i32.sub (call $stack_len (global.get $STK_OUT)) (local.get $off)))
  (local.set $p (call $dup (i32.add (call $stack_base (global.get $STK_OUT)) (local.get $off)) (local.get $n)))
  (call $stack_truncate (global.get $STK_OUT) (local.get $off))
  ;; the cursor continues at `off`, so a record can be built in the middle
  ;; of an output being written
  (call $w_begin (i32.const 0))
  (local.get $p) (local.get $n))

(func $w_tab (call $w_need (i32.const 1)) (call $w_byte (i32.const 0x09)))

;; Hash-canonical scalar (SPEC §10a.3): JSON form, `-` for null.
(func $w_canonical (param $q i32)
  (local $t i32)
  (local.set $t (i32.load (local.get $q)))
  (if (i32.eqz (local.get $t)) (then (call $w_need (i32.const 1)) (call $w_byte (i32.const 0x2D)) (return)))
  (if (call $is_composite (local.get $t)) (then (call $fail_msg (i32.const 43) (i32.const 0) (i32.const 80)) (return)))
  (call $w_value (local.get $t) (i32.load offset=4 (local.get $q)) (i64.load offset=8 (local.get $q))))

;; Sort the (ptr, len) records and hash them in order.
(func $hash_records (param $recs i32) (param $n i32) (result i32 i32)
  (local $i i32) (local $q i32)
  (call $sort_by_key (local.get $recs) (local.get $n) (i32.const 8))
  (call $sha_init)
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $q (i32.add (local.get $recs) (i32.shl (local.get $i) (i32.const 3))))
    (call $sha_update (i32.load (local.get $q)) (i32.load offset=4 (local.get $q)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $sha_final_hex))

;; Value node of member `k` (static key) of a node, or 0.
(func $get (param $node i32) (param $kp i32) (param $kn i32) (result i32)
  (local $m i32)
  (local.set $m (call $field_of (local.get $node) (local.get $kp) (local.get $kn) (i32.const 0)))
  (select (i32.add (local.get $m) (i32.const 8)) (i32.const 0) (local.get $m)))

;; String member as (ptr, len, found); a non-string counts as absent.
(func $get_str (param $node i32) (param $kp i32) (param $kn i32) (result i32 i32 i32)
  (local $v i32)
  (local.set $v (call $get (local.get $node) (local.get $kp) (local.get $kn)))
  (if (i32.eqz (local.get $v)) (then (return (i32.const 0) (i32.const 0) (i32.const 0))))
  (if (i32.ne (i32.load (local.get $v)) (i32.const 5)) (then (return (i32.const 0) (i32.const 0) (i32.const 0))))
  (i32.load offset=4 (local.get $v)) (i32.load offset=8 (local.get $v)) (i32.const 1))

;; Array member as (nodes, count); anything else is empty.
(func $array_of (param $v i32) (result i32 i32)
  (if (i32.eqz (local.get $v)) (then (return (i32.const 0) (i32.const 0))))
  (if (i32.ne (i32.load (local.get $v)) (i32.const 6)) (then (return (i32.const 0) (i32.const 0))))
  (i32.load offset=4 (local.get $v)) (i32.load offset=8 (local.get $v)))

;; ---------------------------------------------------------------------------
;; Pack roots
;; ---------------------------------------------------------------------------

;; Generic: one `R<TAB>field<TAB>value...<LF>` record per row, fields in byte
;; order; records sorted, then SHA-256.
(func $generic_pack_root (param $rows i32) (param $n i32) (result i32 i32)
  (local $recs i32) (local $i i32) (local $row i32) (local $m i32) (local $mn i32) (local $f i32) (local $j i32) (local $off i32) (local $p i32) (local $len i32)
  (local.set $recs (call $alloc (i32.shl (local.get $n) (i32.const 3))))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $row (i32.add (local.get $rows) (i32.shl (local.get $i) (i32.const 4))))
    (if (i32.ne (i32.load (local.get $row)) (i32.const 7)) (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
    (local.set $mn (i32.load offset=8 (local.get $row)))
    (local.set $m (call $dup (i32.load offset=4 (local.get $row)) (i32.mul (local.get $mn) (i32.const 24))))
    (call $sort_by_key (local.get $m) (local.get $mn) (i32.const 24))
    (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
    (local.set $off (call $rec_begin))
    (call $w_need (i32.const 1)) (call $w_byte (i32.const 0x52))
    (local.set $j (i32.const 0))
    (block $jd (loop $jl
      (br_if $jd (i32.ge_u (local.get $j) (local.get $mn)))
      (local.set $f (i32.add (local.get $m) (i32.mul (local.get $j) (i32.const 24))))
      (call $w_tab)
      (call $w_lit (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)))
      (call $w_tab)
      (call $w_canonical (i32.add (local.get $f) (i32.const 8)))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $jl)))
    (call $w_need (i32.const 1)) (call $w_byte (i32.const 0x0A))
    (call $rec_end (local.get $off)) (local.set $len) (local.set $p)
    (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
    (i32.store (i32.add (local.get $recs) (i32.shl (local.get $i) (i32.const 3))) (local.get $p))
    (i32.store offset=4 (i32.add (local.get $recs) (i32.shl (local.get $i) (i32.const 3))) (local.get $len))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $hash_records (local.get $recs) (local.get $n)))

;; Generic over a declared field list: an absent field hashes as `-`.
(func $generic_pack_root_fields (param $rows i32) (param $n i32) (param $fields i32) (param $nf i32) (result i32 i32)
  (local $recs i32) (local $sorted i32) (local $i i32) (local $row i32) (local $j i32) (local $f i32) (local $v i32) (local $off i32) (local $p i32) (local $len i32)
  (if (i32.eqz (local.get $nf)) (then (return (call $generic_pack_root (local.get $rows) (local.get $n)))))
  (local.set $sorted (call $dup (local.get $fields) (i32.shl (local.get $nf) (i32.const 3))))
  (call $sort_by_key (local.get $sorted) (local.get $nf) (i32.const 8))
  (local.set $recs (call $alloc (i32.shl (local.get $n) (i32.const 3))))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $row (i32.add (local.get $rows) (i32.shl (local.get $i) (i32.const 4))))
    (local.set $off (call $rec_begin))
    (call $w_need (i32.const 1)) (call $w_byte (i32.const 0x52))
    (local.set $j (i32.const 0))
    (block $jd (loop $jl
      (br_if $jd (i32.ge_u (local.get $j) (local.get $nf)))
      (local.set $f (i32.add (local.get $sorted) (i32.shl (local.get $j) (i32.const 3))))
      (call $w_tab)
      (call $w_lit (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)))
      (call $w_tab)
      (local.set $v (call $get (local.get $row) (i32.load (local.get $f)) (i32.load offset=4 (local.get $f))))
      (if (local.get $v)
        (then (call $w_canonical (local.get $v)))
        (else (call $w_need (i32.const 1)) (call $w_byte (i32.const 0x2D))))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $jl)))
    (call $w_need (i32.const 1)) (call $w_byte (i32.const 0x0A))
    (call $rec_end (local.get $off)) (local.set $len) (local.set $p)
    (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
    (i32.store (i32.add (local.get $recs) (i32.shl (local.get $i) (i32.const 3))) (local.get $p))
    (i32.store offset=4 (i32.add (local.get $recs) (i32.shl (local.get $i) (i32.const 3))) (local.get $len))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $hash_records (local.get $recs) (local.get $n)))

;; String member or "" (getString(...) orelse "").
(func $str_or_empty (param $node i32) (param $kp i32) (param $kn i32) (result i32 i32)
  (local $p i32) (local $n i32) (local $f i32)
  (call $get_str (local.get $node) (local.get $kp) (local.get $kn)) (local.set $f) (local.set $n) (local.set $p)
  (local.get $p) (local.get $n))

;; Graph (SPEC §10.2): S records sorted among themselves, then E records.
(func $graph_pack_root (param $graph i32) (result i32 i32)
  (local $sv i32) (local $ev i32) (local $syms i32) (local $ns i32) (local $edges i32) (local $ne i32) (local $recs i32)
  (local $i i32) (local $j i32) (local $s i32) (local $e i32) (local $sc i32) (local $di i32) (local $off i32) (local $p i32) (local $n i32)
  (local $kp i32) (local $kn i32) (local $sp i32) (local $sn i32) (local $tp i32) (local $tn i32) (local $skp i32) (local $skn i32) (local $tkp i32) (local $tkn i32)
  (local $qp i32) (local $qn i32)
  (local.set $sv (call $get (local.get $graph) (global.get $K_symbols) (global.get $K_symbols_n)))
  (local.set $ev (call $get (local.get $graph) (global.get $K_edges) (global.get $K_edges_n)))
  (if (i32.and (i32.ne (local.get $sv) (i32.const 0)) (i32.ne (i32.load (local.get $sv)) (i32.const 6))) (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
  (if (i32.and (i32.ne (local.get $ev) (i32.const 0)) (i32.ne (i32.load (local.get $ev)) (i32.const 6))) (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
  (call $array_of (local.get $sv)) (local.set $ns) (local.set $syms)
  (call $array_of (local.get $ev)) (local.set $ne) (local.set $edges)
  (local.set $recs (call $alloc (i32.shl (i32.add (local.get $ns) (local.get $ne)) (i32.const 3))))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $ns)))
    (local.set $s (i32.add (local.get $syms) (i32.shl (local.get $i) (i32.const 4))))
    (local.set $sc (call $get (local.get $s) (global.get $K_score) (global.get $K_score_n)))
    (local.set $di (call $get (local.get $s) (global.get $K_distance) (global.get $K_distance_n)))
    (if (i32.and (i32.ne (local.get $sc) (i32.const 0)) (i32.and (i32.ne (i32.load (local.get $sc)) (i32.const 3)) (i32.ne (i32.load (local.get $sc)) (i32.const 4))))
      (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
    (if (i32.and (i32.ne (local.get $di) (i32.const 0)) (i32.ne (i32.load (local.get $di)) (i32.const 3)))
      (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
    (local.set $off (call $rec_begin))
    (call $w_need (i32.const 1)) (call $w_byte (i32.const 0x53))
    (call $w_tab)
    (call $str_or_empty (local.get $s) (global.get $K_kind) (global.get $K_kind_n)) (local.set $n) (local.set $p)
    (call $abbreviate_kind (local.get $p) (local.get $n)) (local.set $kn) (local.set $kp)
    (call $w_lit (local.get $kp) (local.get $kn))
    (call $w_tab)
    (call $str_or_empty (local.get $s) (global.get $K_qualifiedName) (global.get $K_qualifiedName_n)) (local.set $n) (local.set $p)
    (call $w_lit (local.get $p) (local.get $n))
    (call $w_tab)
    (if (local.get $sc)
      (then (call $w_value (i32.load (local.get $sc)) (i32.const 0) (i64.load offset=8 (local.get $sc))))
      (else (call $w_i64 (i64.const 0))))
    (call $w_tab)
    (call $str_or_empty (local.get $s) (global.get $K_provenance) (global.get $K_provenance_n)) (local.set $n) (local.set $p)
    (call $w_lit (local.get $p) (local.get $n))
    (call $w_tab)
    (call $w_i64 (if (result i64) (local.get $di) (then (i64.load offset=8 (local.get $di))) (else (i64.const 0))))
    (call $w_need (i32.const 1)) (call $w_byte (i32.const 0x0A))
    (call $rec_end (local.get $off)) (local.set $n) (local.set $p)
    (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
    (i32.store (i32.add (local.get $recs) (i32.shl (local.get $i) (i32.const 3))) (local.get $p))
    (i32.store offset=4 (i32.add (local.get $recs) (i32.shl (local.get $i) (i32.const 3))) (local.get $n))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $ne)))
    (local.set $e (i32.add (local.get $edges) (i32.shl (local.get $i) (i32.const 4))))
    (call $str_or_empty (local.get $e) (global.get $K_source) (global.get $K_source_n)) (local.set $sn) (local.set $sp)
    (call $str_or_empty (local.get $e) (global.get $K_target) (global.get $K_target_n)) (local.set $tn) (local.set $tp)
    (local.set $skn (i32.const 0)) (local.set $tkn (i32.const 0)) (local.set $skp (i32.const 0)) (local.set $tkp (i32.const 0))
    (local.set $j (i32.const 0))
    (block $jd (loop $jl
      (br_if $jd (i32.ge_u (local.get $j) (local.get $ns)))
      (local.set $s (i32.add (local.get $syms) (i32.shl (local.get $j) (i32.const 4))))
      (call $str_or_empty (local.get $s) (global.get $K_qualifiedName) (global.get $K_qualifiedName_n)) (local.set $qn) (local.set $qp)
      (if (i32.and (i32.eqz (local.get $skn)) (call $str_eq (local.get $qp) (local.get $qn) (local.get $sp) (local.get $sn)))
        (then
          (call $str_or_empty (local.get $s) (global.get $K_kind) (global.get $K_kind_n)) (local.set $n) (local.set $p)
          (call $abbreviate_kind (local.get $p) (local.get $n)) (local.set $skn) (local.set $skp)))
      (if (i32.and (i32.eqz (local.get $tkn)) (call $str_eq (local.get $qp) (local.get $qn) (local.get $tp) (local.get $tn)))
        (then
          (call $str_or_empty (local.get $s) (global.get $K_kind) (global.get $K_kind_n)) (local.set $n) (local.set $p)
          (call $abbreviate_kind (local.get $p) (local.get $n)) (local.set $tkn) (local.set $tkp)))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $jl)))
    (local.set $off (call $rec_begin))
    (call $w_need (i32.const 1)) (call $w_byte (i32.const 0x45))
    (call $w_tab) (call $w_lit (local.get $skp) (local.get $skn))
    (call $w_tab) (call $w_lit (local.get $sp) (local.get $sn))
    (call $w_tab) (call $w_lit (local.get $tkp) (local.get $tkn))
    (call $w_tab) (call $w_lit (local.get $tp) (local.get $tn))
    (call $w_tab)
    (call $str_or_empty (local.get $e) (global.get $K_edgeType) (global.get $K_edgeType_n)) (local.set $n) (local.set $p)
    (call $w_lit (local.get $p) (local.get $n))
    (call $w_need (i32.const 1)) (call $w_byte (i32.const 0x0A))
    (call $rec_end (local.get $off)) (local.set $n) (local.set $p)
    (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
    (local.set $j (i32.add (local.get $ns) (local.get $i)))
    (i32.store (i32.add (local.get $recs) (i32.shl (local.get $j) (i32.const 3))) (local.get $p))
    (i32.store offset=4 (i32.add (local.get $recs) (i32.shl (local.get $j) (i32.const 3))) (local.get $n))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $sort_by_key (local.get $recs) (local.get $ns) (i32.const 8))
  (call $sort_by_key (i32.add (local.get $recs) (i32.shl (local.get $ns) (i32.const 3))) (local.get $ne) (i32.const 8))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (call $sha_init)
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (i32.add (local.get $ns) (local.get $ne))))
    (call $sha_update (i32.load (i32.add (local.get $recs) (i32.shl (local.get $i) (i32.const 3))))
                      (i32.load offset=4 (i32.add (local.get $recs) (i32.shl (local.get $i) (i32.const 3)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $sha_final_hex))

;; ---------------------------------------------------------------------------
;; Generic delta application (SPEC §10a.5): atomic, on a scratch copy
;; ---------------------------------------------------------------------------

;; Returns (rows, count). Slots: one row node pointer per identity in
;; first-seen order (0 = removed); the string map gives an identity's slot.
(func $apply_generic_delta (param $base i32) (param $nb i32) (param $kp i32) (param $kn i32)
                           (param $added i32) (param $na i32) (param $changed i32) (param $nc i32) (param $removed i32) (param $nr i32) (result i32 i32)
  (local $map i32) (local $slots i32) (local $n i32) (local $i i32) (local $r i32) (local $v i32) (local $ip i32) (local $in i32) (local $idx i32)
  (local $out i32) (local $cnt i32) (local $q i32)
  (local.set $map (call $ks_new))
  (local.set $slots (call $alloc (i32.shl (i32.add (local.get $nb) (local.get $na)) (i32.const 2))))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nb)))
    (local.set $r (i32.add (local.get $base) (i32.shl (local.get $i) (i32.const 4))))
    (local.set $v (call $get (local.get $r) (local.get $kp) (local.get $kn)))
    (if (i32.eqz (local.get $v)) (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
    (call $identity_key (i32.load (local.get $v)) (i32.load offset=4 (local.get $v)) (i64.load offset=8 (local.get $v))) (local.set $in) (local.set $ip)
    (if (i32.ge_s (call $sm_find (local.get $map) (local.get $ip) (local.get $in) (i32.const 1) (local.get $n)) (i32.const 0))
      (then (call $fail (i32.const 15) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
    (i32.store (i32.add (local.get $slots) (i32.shl (local.get $n) (i32.const 2))) (local.get $r))
    (local.set $n (i32.add (local.get $n) (i32.const 1)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $na)))
    (local.set $r (i32.add (local.get $added) (i32.shl (local.get $i) (i32.const 4))))
    (local.set $v (call $get (local.get $r) (local.get $kp) (local.get $kn)))
    (if (i32.eqz (local.get $v)) (then (call $fail (i32.const 40) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
    (call $identity_key (i32.load (local.get $v)) (i32.load offset=4 (local.get $v)) (i64.load offset=8 (local.get $v))) (local.set $in) (local.set $ip)
    (if (i32.ge_s (call $sm_find (local.get $map) (local.get $ip) (local.get $in) (i32.const 1) (local.get $n)) (i32.const 0))
      (then (call $fail_msg (i32.const 42) (i32.const 0) (i32.const 72)) (return (i32.const 0) (i32.const 0))))
    (i32.store (i32.add (local.get $slots) (i32.shl (local.get $n) (i32.const 2))) (local.get $r))
    (local.set $n (i32.add (local.get $n) (i32.const 1)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nc)))
    (local.set $r (i32.add (local.get $changed) (i32.shl (local.get $i) (i32.const 4))))
    (local.set $v (call $get (local.get $r) (local.get $kp) (local.get $kn)))
    (if (i32.eqz (local.get $v)) (then (call $fail (i32.const 40) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
    (call $identity_key (i32.load (local.get $v)) (i32.load offset=4 (local.get $v)) (i64.load offset=8 (local.get $v))) (local.set $in) (local.set $ip)
    (local.set $idx (call $sm_find (local.get $map) (local.get $ip) (local.get $in) (i32.const 0) (i32.const 0)))
    (if (i32.lt_s (local.get $idx) (i32.const 0)) (then (call $fail_msg (i32.const 42) (i32.const 0) (i32.const 73)) (return (i32.const 0) (i32.const 0))))
    (local.set $q (i32.add (local.get $slots) (i32.shl (local.get $idx) (i32.const 2))))
    (if (i32.eqz (i32.load (local.get $q))) (then (call $fail_msg (i32.const 42) (i32.const 0) (i32.const 73)) (return (i32.const 0) (i32.const 0))))
    (i32.store (local.get $q) (local.get $r))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nr)))
    (local.set $v (i32.add (local.get $removed) (i32.shl (local.get $i) (i32.const 4))))
    (call $identity_key (i32.load (local.get $v)) (i32.load offset=4 (local.get $v)) (i64.load offset=8 (local.get $v))) (local.set $in) (local.set $ip)
    (local.set $idx (call $sm_find (local.get $map) (local.get $ip) (local.get $in) (i32.const 0) (i32.const 0)))
    (if (i32.lt_s (local.get $idx) (i32.const 0)) (then (call $fail_msg (i32.const 42) (i32.const 0) (i32.const 74)) (return (i32.const 0) (i32.const 0))))
    (local.set $q (i32.add (local.get $slots) (i32.shl (local.get $idx) (i32.const 2))))
    (if (i32.eqz (i32.load (local.get $q))) (then (call $fail_msg (i32.const 42) (i32.const 0) (i32.const 74)) (return (i32.const 0) (i32.const 0))))
    (i32.store (local.get $q) (i32.const 0))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.set $out (call $alloc (i32.shl (local.get $n) (i32.const 4))))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $r (i32.load (i32.add (local.get $slots) (i32.shl (local.get $i) (i32.const 2)))))
    (if (local.get $r)
      (then
        (v128.store (i32.add (local.get $out) (i32.shl (local.get $cnt) (i32.const 4))) (v128.load (local.get $r)))
        (local.set $cnt (i32.add (local.get $cnt) (i32.const 1)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $out) (local.get $cnt))

;; root_mismatch when an expected root is given and differs.
(func $check_root (param $ep i32) (param $en i32) (param $has i32) (param $ap i32) (param $an i32)
  (if (i32.and (local.get $has) (i32.eqz (call $str_eq (local.get $ep) (local.get $en) (local.get $ap) (local.get $an))))
    (then (call $fail (i32.const 41) (i32.const 0)))))

;; Fixture-shaped verify: {base:{key,rows}, delta:{...}, expectedNewRoot?}.
(func $delta_verify (param $input i32) (result i32 i32)
  (local $base i32) (local $delta i32) (local $kp i32) (local $kn i32) (local $f i32) (local $rows i32) (local $nrows i32)
  (local $rp i32) (local $rn i32) (local $ep i32) (local $en i32) (local $eh i32) (local $res i32) (local $nres i32)
  (local $ad i32) (local $nad i32) (local $ch i32) (local $nch i32) (local $rm i32) (local $nrm i32)
  (local.set $base (call $get (local.get $input) (global.get $K_base) (global.get $K_base_n)))
  (if (i32.eqz (local.get $base)) (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
  (local.set $delta (call $get (local.get $input) (global.get $K_delta) (global.get $K_delta_n)))
  (if (i32.eqz (local.get $delta)) (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
  (call $get_str (local.get $delta) (global.get $K_key) (global.get $K_key_n)) (local.set $f) (local.set $kn) (local.set $kp)
  (if (i32.eqz (local.get $f))
    (then
      (call $get_str (local.get $base) (global.get $K_key) (global.get $K_key_n)) (local.set $f) (local.set $kn) (local.set $kp)
      (if (i32.eqz (local.get $f)) (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))))
  (call $array_of (call $get (local.get $base) (global.get $K_rows) (global.get $K_rows_n))) (local.set $nrows) (local.set $rows)
  (call $generic_pack_root (local.get $rows) (local.get $nrows)) (local.set $rn) (local.set $rp)
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (call $get_str (local.get $delta) (global.get $K_baseRoot) (global.get $K_baseRoot_n)) (local.set $eh) (local.set $en) (local.set $ep)
  (call $check_root (local.get $ep) (local.get $en) (local.get $eh) (local.get $rp) (local.get $rn))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (call $array_of (call $get (local.get $delta) (global.get $K_added) (global.get $K_added_n))) (local.set $nad) (local.set $ad)
  (call $array_of (call $get (local.get $delta) (global.get $K_changed) (global.get $K_changed_n))) (local.set $nch) (local.set $ch)
  (call $array_of (call $get (local.get $delta) (global.get $K_removed) (global.get $K_removed_n))) (local.set $nrm) (local.set $rm)
  (call $apply_generic_delta (local.get $rows) (local.get $nrows) (local.get $kp) (local.get $kn)
                             (local.get $ad) (local.get $nad) (local.get $ch) (local.get $nch) (local.get $rm) (local.get $nrm))
  (local.set $nres) (local.set $res)
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (call $generic_pack_root (local.get $res) (local.get $nres)) (local.set $rn) (local.set $rp)
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (call $get_str (local.get $delta) (global.get $K_newRoot) (global.get $K_newRoot_n)) (local.set $eh) (local.set $en) (local.set $ep)
  (call $check_root (local.get $ep) (local.get $en) (local.get $eh) (local.get $rp) (local.get $rn))
  (call $get_str (local.get $input) (global.get $K_expectedNewRoot) (global.get $K_expectedNewRoot_n)) (local.set $eh) (local.set $en) (local.set $ep)
  (call $check_root (local.get $ep) (local.get $en) (local.get $eh) (local.get $rp) (local.get $rn))
  (local.get $rp) (local.get $rn))

;; Build the document of a wire carried inside JSON input.
(func $load_wire (param $p i32) (param $n i32)
  (global.set $pos (i32.const 0)) (global.set $depth (i32.const 0)) (global.set $nlines (i32.const 0))
  (call $build_document (local.get $p) (local.get $n)))

;; Consumer path: {wire, base:{key,rows}, expectedNewRoot?}.
(func $delta_decode_apply (param $input i32) (result i32 i32)
  (local $wp i32) (local $wn i32) (local $f i32) (local $base i32) (local $d i32) (local $kp i32) (local $kn i32)
  (local $rows i32) (local $nrows i32) (local $rp i32) (local $rn i32) (local $res i32) (local $nres i32) (local $ep i32) (local $en i32) (local $eh i32)
  (call $get_str (local.get $input) (global.get $K_wire) (global.get $K_wire_n)) (local.set $f) (local.set $wn) (local.set $wp)
  (if (i32.eqz (local.get $f)) (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
  (local.set $base (call $get (local.get $input) (global.get $K_base) (global.get $K_base_n)))
  (if (i32.eqz (local.get $base)) (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
  (call $load_wire (local.get $wp) (local.get $wn))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (if (i32.or (global.get $profile) (i32.eqz (call $header_flag (global.get $S_DELTA) (i32.const 5))))
    (then (call $fail (i32.const 40) (i32.const 1)) (return (i32.const 0) (i32.const 0))))
  (local.set $d (call $parse_generic_delta))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (local.set $kp (i32.load (local.get $d))) (local.set $kn (i32.load offset=4 (local.get $d)))
  (if (i32.eqz (local.get $kn))
    (then
      (call $get_str (local.get $base) (global.get $K_key) (global.get $K_key_n)) (local.set $f) (local.set $kn) (local.set $kp)
      (if (i32.eqz (local.get $f)) (then (call $fail (i32.const 40) (i32.const 1)) (return (i32.const 0) (i32.const 0))))))
  (call $array_of (call $get (local.get $base) (global.get $K_rows) (global.get $K_rows_n))) (local.set $nrows) (local.set $rows)
  (call $generic_pack_root (local.get $rows) (local.get $nrows)) (local.set $rn) (local.set $rp)
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (call $check_root (i32.load offset=8 (local.get $d)) (i32.load offset=12 (local.get $d)) (i32.ne (i32.load offset=12 (local.get $d)) (i32.const 0)) (local.get $rp) (local.get $rn))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (call $apply_generic_delta (local.get $rows) (local.get $nrows) (local.get $kp) (local.get $kn)
                             (i32.load offset=24 (local.get $d)) (i32.load offset=28 (local.get $d))
                             (i32.load offset=32 (local.get $d)) (i32.load offset=36 (local.get $d))
                             (i32.load offset=40 (local.get $d)) (i32.load offset=44 (local.get $d)))
  (local.set $nres) (local.set $res)
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (call $generic_pack_root (local.get $res) (local.get $nres)) (local.set $rn) (local.set $rp)
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (call $check_root (i32.load offset=16 (local.get $d)) (i32.load offset=20 (local.get $d)) (i32.ne (i32.load offset=20 (local.get $d)) (i32.const 0)) (local.get $rp) (local.get $rn))
  (call $get_str (local.get $input) (global.get $K_expectedNewRoot) (global.get $K_expectedNewRoot_n)) (local.set $eh) (local.set $en) (local.set $ep)
  (call $check_root (local.get $ep) (local.get $en) (local.get $eh) (local.get $rp) (local.get $rn))
  (local.get $rp) (local.get $rn))

;; ---------------------------------------------------------------------------
;; Graph delta application (SPEC §10.4)
;; ---------------------------------------------------------------------------

;; Identity strings: symbol "kind<TAB>qname" (abbreviated kind), edge
;; "source<TAB>target<TAB>type".
(func $symbol_identity (param $s i32) (result i32 i32)
  (local $p i32) (local $n i32) (local $kp i32) (local $kn i32) (local $off i32)
  (local.set $off (call $rec_begin))
  (call $str_or_empty (local.get $s) (global.get $K_kind) (global.get $K_kind_n)) (local.set $n) (local.set $p)
  (call $abbreviate_kind (local.get $p) (local.get $n)) (local.set $kn) (local.set $kp)
  (call $w_lit (local.get $kp) (local.get $kn))
  (call $w_tab)
  (call $str_or_empty (local.get $s) (global.get $K_qualifiedName) (global.get $K_qualifiedName_n)) (local.set $n) (local.set $p)
  (call $w_lit (local.get $p) (local.get $n))
  (call $rec_end (local.get $off)))

(func $edge_identity (param $e i32) (result i32 i32)
  (local $p i32) (local $n i32) (local $off i32)
  (local.set $off (call $rec_begin))
  (call $str_or_empty (local.get $e) (global.get $K_source) (global.get $K_source_n)) (local.set $n) (local.set $p)
  (call $w_lit (local.get $p) (local.get $n))
  (call $w_tab)
  (call $str_or_empty (local.get $e) (global.get $K_target) (global.get $K_target_n)) (local.set $n) (local.set $p)
  (call $w_lit (local.get $p) (local.get $n))
  (call $w_tab)
  (call $str_or_empty (local.get $e) (global.get $K_edgeType) (global.get $K_edgeType_n)) (local.set $n) (local.set $p)
  (call $w_lit (local.get $p) (local.get $n))
  (call $rec_end (local.get $off)))

;; Insert every identity of the nodes into a fresh key set.
(func $identity_set (param $nodes i32) (param $n i32) (param $edge i32) (result i32)
  (local $set i32) (local $i i32) (local $p i32) (local $len i32)
  (local.set $set (call $ks_new))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (if (result i32 i32) (local.get $edge)
      (then (call $edge_identity (i32.add (local.get $nodes) (i32.shl (local.get $i) (i32.const 4)))))
      (else (call $symbol_identity (i32.add (local.get $nodes) (i32.shl (local.get $i) (i32.const 4))))))
    (local.set $len) (local.set $p)
    (if (global.get $err) (then (return (i32.const 0))))
    (drop (call $ks_insert (local.get $set) (local.get $p) (local.get $len)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $set))

;; Key-set membership without inserting.
(func $ks_has (param $s i32) (param $p i32) (param $n i32) (result i32)
  (local $h i32) (local $mask i32) (local $i i32) (local $e i32)
  (if (i32.eqz (i32.load offset=4 (local.get $s))) (then (return (i32.const 0))))
  (local.set $h (i32.or (call $hash (local.get $p) (local.get $n)) (i32.const 1)))
  (local.set $mask (i32.sub (i32.load offset=4 (local.get $s)) (i32.const 1)))
  (local.set $i (i32.and (local.get $h) (local.get $mask)))
  (loop $probe
    (local.set $e (i32.add (i32.load offset=8 (local.get $s)) (i32.mul (local.get $i) (i32.const 12))))
    (if (i32.eqz (i32.load (local.get $e))) (then (return (i32.const 0))))
    (if (i32.eq (i32.load (local.get $e)) (local.get $h))
      (then (if (call $str_eq (i32.load offset=4 (local.get $e)) (i32.load offset=8 (local.get $e)) (local.get $p) (local.get $n))
        (then (return (i32.const 1))))))
    (local.set $i (i32.and (i32.add (local.get $i) (i32.const 1)) (local.get $mask)))
    (br $probe))
  (unreachable))

;; Nodes whose identity is not in `drop`, followed by the `extra` nodes.
(func $keep_and_append (param $nodes i32) (param $n i32) (param $edge i32) (param $drop i32) (param $extra i32) (param $ne i32) (result i32 i32)
  (local $out i32) (local $cnt i32) (local $i i32) (local $p i32) (local $len i32) (local $q i32)
  (local.set $out (call $alloc (i32.shl (i32.add (local.get $n) (local.get $ne)) (i32.const 4))))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $q (i32.add (local.get $nodes) (i32.shl (local.get $i) (i32.const 4))))
    (if (result i32 i32) (local.get $edge) (then (call $edge_identity (local.get $q))) (else (call $symbol_identity (local.get $q))))
    (local.set $len) (local.set $p)
    (if (i32.eqz (call $ks_has (local.get $drop) (local.get $p) (local.get $len)))
      (then
        (v128.store (i32.add (local.get $out) (i32.shl (local.get $cnt) (i32.const 4))) (v128.load (local.get $q)))
        (local.set $cnt (i32.add (local.get $cnt) (i32.const 1)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (memory.copy (i32.add (local.get $out) (i32.shl (local.get $cnt) (i32.const 4))) (local.get $extra) (i32.shl (local.get $ne) (i32.const 4)))
  (local.get $out) (i32.add (local.get $cnt) (local.get $ne)))

;; {wire, base:{symbols,edges}} -> {"root": ..., "snapshot": {...}} JSON.
(func $graph_delta_apply (param $input i32)
  (local $wp i32) (local $wn i32) (local $f i32) (local $base i32) (local $dt i32) (local $da i32) (local $db i64) (local $dnode i32)
  (local $rp i32) (local $rn i32) (local $hp i32) (local $hn i32) (local $hf i32)
  (local $bs i32) (local $nbs i32) (local $be i32) (local $nbe i32) (local $rs i32) (local $nrs i32) (local $as i32) (local $nas i32)
  (local $er i32) (local $ner i32) (local $ea i32) (local $nea i32) (local $symset i32) (local $rsym i32) (local $edgeset i32) (local $redge i32)
  (local $i i32) (local $p i32) (local $len i32) (local $syms i32) (local $nsy i32) (local $edges i32) (local $ned i32) (local $mark i32) (local $snap i32)
  (local $st i32) (local $sa i32) (local $sb i64)
  (call $get_str (local.get $input) (global.get $K_wire) (global.get $K_wire_n)) (local.set $f) (local.set $wn) (local.set $wp)
  (if (i32.eqz (local.get $f)) (then (call $fail (i32.const 43) (i32.const 0)) (return)))
  (local.set $base (call $get (local.get $input) (global.get $K_base) (global.get $K_base_n)))
  (if (i32.eqz (local.get $base)) (then (call $fail (i32.const 43) (i32.const 0)) (return)))
  (call $load_wire (local.get $wp) (local.get $wn))
  (if (global.get $err) (then (return)))
  (if (i32.or (i32.ne (global.get $profile) (i32.const 1)) (i32.eqz (call $header_flag (global.get $S_DELTA) (i32.const 5))))
    (then (call $fail (i32.const 40) (i32.const 1)) (return)))
  (call $graph_delta) (local.set $db) (local.set $da) (local.set $dt)
  (if (global.get $err) (then (return)))
  (local.set $dnode (call $alloc (i32.const 16)))
  (if (global.get $err) (then (return)))
  (call $store_node (local.get $dnode) (local.get $dt) (local.get $da) (local.get $db))
  (call $header_get (global.get $K_base_root) (global.get $K_base_root_n)) (local.set $hf) (local.set $hn) (local.set $hp)
  (if (local.get $hf)
    (then
      (call $graph_pack_root (local.get $base)) (local.set $rn) (local.set $rp)
      (if (global.get $err) (then (return)))
      (call $check_root (local.get $hp) (local.get $hn) (i32.const 1) (local.get $rp) (local.get $rn))
      (if (global.get $err) (then (return)))))
  (call $array_of (call $get (local.get $base) (global.get $K_symbols) (global.get $K_symbols_n))) (local.set $nbs) (local.set $bs)
  (call $array_of (call $get (local.get $base) (global.get $K_edges) (global.get $K_edges_n))) (local.set $nbe) (local.set $be)
  (call $array_of (call $get (local.get $dnode) (global.get $K_removed) (global.get $K_removed_n))) (local.set $nrs) (local.set $rs)
  (call $array_of (call $get (local.get $dnode) (global.get $K_added) (global.get $K_added_n))) (local.set $nas) (local.set $as)
  (call $array_of (call $get (local.get $dnode) (global.get $K_edgesRemoved) (global.get $K_edgesRemoved_n))) (local.set $ner) (local.set $er)
  (call $array_of (call $get (local.get $dnode) (global.get $K_edgesAdded) (global.get $K_edgesAdded_n))) (local.set $nea) (local.set $ea)
  ;; validate every operation against the base before touching anything
  (local.set $symset (call $identity_set (local.get $bs) (local.get $nbs) (i32.const 0)))
  (local.set $rsym (call $ks_new))
  (if (global.get $err) (then (return)))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nrs)))
    (call $symbol_identity (i32.add (local.get $rs) (i32.shl (local.get $i) (i32.const 4)))) (local.set $len) (local.set $p)
    (if (i32.eqz (call $ks_has (local.get $symset) (local.get $p) (local.get $len))) (then (call $fail_msg (i32.const 42) (i32.const 0) (i32.const 75)) (return)))
    (if (call $ks_insert (local.get $rsym) (local.get $p) (local.get $len)) (then (call $fail_msg (i32.const 42) (i32.const 0) (i32.const 76)) (return)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nas)))
    (call $symbol_identity (i32.add (local.get $as) (i32.shl (local.get $i) (i32.const 4)))) (local.set $len) (local.set $p)
    (if (i32.and (call $ks_has (local.get $symset) (local.get $p) (local.get $len)) (i32.eqz (call $ks_has (local.get $rsym) (local.get $p) (local.get $len))))
      (then (call $fail_msg (i32.const 42) (i32.const 0) (i32.const 77)) (return)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.set $edgeset (call $identity_set (local.get $be) (local.get $nbe) (i32.const 1)))
  (local.set $redge (call $ks_new))
  (if (global.get $err) (then (return)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $ner)))
    (call $edge_identity (i32.add (local.get $er) (i32.shl (local.get $i) (i32.const 4)))) (local.set $len) (local.set $p)
    (if (i32.eqz (call $ks_has (local.get $edgeset) (local.get $p) (local.get $len))) (then (call $fail_msg (i32.const 42) (i32.const 0) (i32.const 78)) (return)))
    (drop (call $ks_insert (local.get $redge) (local.get $p) (local.get $len)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nea)))
    (call $edge_identity (i32.add (local.get $ea) (i32.shl (local.get $i) (i32.const 4)))) (local.set $len) (local.set $p)
    (if (i32.and (call $ks_has (local.get $edgeset) (local.get $p) (local.get $len)) (i32.eqz (call $ks_has (local.get $redge) (local.get $p) (local.get $len))))
      (then (call $fail_msg (i32.const 42) (i32.const 0) (i32.const 79)) (return)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (if (global.get $err) (then (return)))
  ;; apply to a scratch snapshot
  (call $keep_and_append (local.get $bs) (local.get $nbs) (i32.const 0) (local.get $rsym) (local.get $as) (local.get $nas)) (local.set $nsy) (local.set $syms)
  (call $keep_and_append (local.get $be) (local.get $nbe) (i32.const 1) (local.get $redge) (local.get $ea) (local.get $nea)) (local.set $ned) (local.set $edges)
  (if (global.get $err) (then (return)))
  (local.set $mark (call $obj_begin))
  (call $obj_add (global.get $K_symbols) (global.get $K_symbols_n) (i32.const 6) (local.get $syms) (i64.extend_i32_u (local.get $nsy)))
  (call $obj_add (global.get $K_edges) (global.get $K_edges_n) (i32.const 6) (local.get $edges) (i64.extend_i32_u (local.get $ned)))
  (call $obj_end (local.get $mark)) (local.set $sb) (local.set $sa) (local.set $st)
  (local.set $snap (call $alloc (i32.const 16)))
  (if (global.get $err) (then (return)))
  (call $store_node (local.get $snap) (local.get $st) (local.get $sa) (local.get $sb))
  (call $graph_pack_root (local.get $snap)) (local.set $rn) (local.set $rp)
  (if (global.get $err) (then (return)))
  (call $header_get (global.get $K_new_root) (global.get $K_new_root_n)) (local.set $hf) (local.set $hn) (local.set $hp)
  (call $check_root (local.get $hp) (local.get $hn) (local.get $hf) (local.get $rp) (local.get $rn))
  (if (global.get $err) (then (return)))
  (local.set $mark (call $obj_begin))
  (call $obj_add_str (global.get $K_root) (global.get $K_root_n) (local.get $rp) (local.get $rn))
  (call $obj_add (global.get $K_snapshot) (global.get $K_snapshot_n) (local.get $st) (local.get $sa) (local.get $sb))
  (call $obj_end (local.get $mark)) (local.set $sb) (local.set $sa) (local.set $st)
  (call $w_begin (i32.const 256))
  (call $w_value (local.get $st) (local.get $sa) (local.get $sb))
  (call $w_sync))

;; {symbols,edges} => graph root; {rows, fields?} => generic root.
(func $pack_root (param $input i32) (result i32 i32)
  (local $rows i32) (local $fv i32) (local $fl i32) (local $nfl i32) (local $list i32) (local $cnt i32) (local $i i32) (local $q i32)
  (local.set $rows (call $get (local.get $input) (global.get $K_rows) (global.get $K_rows_n)))
  (if (i32.eqz (local.get $rows)) (then (return (call $graph_pack_root (local.get $input)))))
  (if (i32.ne (i32.load (local.get $rows)) (i32.const 6)) (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
  (call $array_of (call $get (local.get $input) (global.get $K_fields) (global.get $K_fields_n))) (local.set $nfl) (local.set $fl)
  (local.set $list (call $alloc (i32.shl (local.get $nfl) (i32.const 3))))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nfl)))
    (local.set $q (i32.add (local.get $fl) (i32.shl (local.get $i) (i32.const 4))))
    (if (i32.eq (i32.load (local.get $q)) (i32.const 5))
      (then
        (i32.store (i32.add (local.get $list) (i32.shl (local.get $cnt) (i32.const 3))) (i32.load offset=4 (local.get $q)))
        (i32.store offset=4 (i32.add (local.get $list) (i32.shl (local.get $cnt) (i32.const 3))) (i32.load offset=8 (local.get $q)))
        (local.set $cnt (i32.add (local.get $cnt) (i32.const 1)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $generic_pack_root_fields (i32.load offset=4 (local.get $rows)) (i32.load offset=8 (local.get $rows)) (local.get $list) (local.get $cnt)))

;; ---------------------------------------------------------------------------
;; Exports (input: JSON; duplicate keys allowed, as in the Zig build)
;; ---------------------------------------------------------------------------

;; Parse the input JSON into a node in the arena (0 on error).
(func $json_input (param $len i32) (result i32)
  (local $q i32) (local $vt i32) (local $va i32) (local $vb i64)
  (call $parse_json (global.get $in_ptr) (local.get $len) (i32.const 0)) (local.set $vb) (local.set $va) (local.set $vt)
  (if (global.get $err) (then (return (i32.const 0))))
  (local.set $q (call $alloc (i32.const 16)))
  (if (local.get $q) (then (call $store_node (local.get $q) (local.get $vt) (local.get $va) (local.get $vb))))
  (local.get $q))

;; Publish a (ptr, len) string result.
(func $finish_str (param $p i32) (param $n i32) (result i32)
  (global.set $unsafe_ints (i32.const 0))
  (if (global.get $err) (then (return (global.get $err))))
  (global.set $out_ptr (local.get $p))
  (global.set $out_len (local.get $n))
  (i32.const 0))

(func (export "gcf_pack_root") (param $len i32) (result i32)
  (local $in i32)
  (local.set $in (call $json_input (local.get $len)))
  (if (global.get $err) (then (return (global.get $err))))
  (call $pack_root (local.get $in))
  (call $finish_str))

(func (export "gcf_delta_verify") (param $len i32) (result i32)
  (local $in i32)
  (local.set $in (call $json_input (local.get $len)))
  (if (global.get $err) (then (return (global.get $err))))
  (call $delta_verify (local.get $in))
  (call $finish_str))

(func (export "gcf_delta_decode_apply") (param $len i32) (result i32)
  (local $in i32)
  (local.set $in (call $json_input (local.get $len)))
  (if (global.get $err) (then (return (global.get $err))))
  (call $delta_decode_apply (local.get $in))
  (call $finish_str))

(func (export "gcf_graph_delta_apply") (param $len i32) (result i32)
  (local $in i32)
  (local.set $in (call $json_input (local.get $len)))
  (if (global.get $err) (then (return (global.get $err))))
  (call $graph_delta_apply (local.get $in))
  (if (global.get $err) (then (return (global.get $err))))
  (call $out_finish)
  (i32.const 0))

;; SHA-256 of the input as "sha256:<hex>" (tests).
(func (export "gcf_debug_sha256") (param $len i32) (result i32)
  (call $sha_init)
  (call $sha_update (global.get $in_ptr) (local.get $len))
  (call $sha_final_hex)
  (call $finish_str))
