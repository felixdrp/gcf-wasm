;;
;; 14_delta_enc.wat — generic delta encoders (SPEC §10a) and value grouping
;; (SPEC §7.4.8). Mirrors encoder.zig encodeGenericFull / encodeGenericDelta
;; / diffAndEncode / encodeGrouped.

;; Render at the output cursor, copy to the arena, rewind: canonical texts
;; used as identities and for comparisons.
;; mode 0: o_scalar, 1: o_const_value, 2: canonicalCell (strings always quoted)
(func $render (param $q i32) (param $mode i32) (result i32 i32)
  (local $off i32) (local $t i32)
  (local.set $off (call $rec_begin))
  (local.set $t (i32.load (local.get $q)))
  (if (i32.eqz (local.get $mode)) (then (call $o_scalar_at (local.get $q))))
  (if (i32.eq (local.get $mode) (i32.const 1)) (then (call $o_const_value (local.get $q))))
  (if (i32.eq (local.get $mode) (i32.const 2))
    (then
      (if (call $is_composite (local.get $t))
        (then (call $fail (i32.const 44) (i32.const 0)))
        (else (if (i32.eq (local.get $t) (i32.const 5))
          (then (call $o_quoted (i32.load offset=4 (local.get $q)) (i32.load offset=8 (local.get $q))))
          (else (call $o_scalar_at (local.get $q))))))))
  (call $rec_end (local.get $off)))

;; A static null node (for "absent counts as null").
(global $NULL_NODE i32 (i32.const 0x7F80))

;; fieldList(): 'fields' as a (ptr, len) list; a non-string is invalid_json.
(func $field_list (param $v i32) (result i32 i32)
  (local $arr i32) (local $n i32) (local $out i32) (local $i i32) (local $q i32)
  (call $array_of (local.get $v)) (local.set $n) (local.set $arr)
  (local.set $out (call $alloc (i32.shl (local.get $n) (i32.const 3))))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $q (i32.add (local.get $arr) (i32.shl (local.get $i) (i32.const 4))))
    (if (i32.ne (i32.load (local.get $q)) (i32.const 5)) (then (call $fail (i32.const 43) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
    (i32.store (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 3))) (i32.load offset=4 (local.get $q)))
    (i32.store offset=4 (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 3))) (i32.load offset=8 (local.get $q)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $out) (local.get $n))

;; Field declaration with '@' on the key field.
(func $o_field_decl (param $fields i32) (param $nf i32) (param $kp i32) (param $kn i32)
  (local $i i32) (local $f i32)
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nf)))
    (if (local.get $i) (then (call $o_byte (i32.const 0x2C))))
    (local.set $f (i32.add (local.get $fields) (i32.shl (local.get $i) (i32.const 3))))
    (if (call $str_eq (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)) (local.get $kp) (local.get $kn)) (then (call $o_byte (i32.const 0x40))))
    (call $o_key (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l))))

;; Row cells in declared order; an absent field is null (`-`).
(func $o_delta_row (param $row i32) (param $fields i32) (param $nf i32)
  (local $i i32) (local $f i32) (local $m i32) (local $v i32)
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nf)))
    (if (local.get $i) (then (call $o_byte (i32.const 0x7C))))
    (local.set $f (i32.add (local.get $fields) (i32.shl (local.get $i) (i32.const 3))))
    (local.set $m (call $field_of (local.get $row) (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)) (local.get $i)))
    (local.set $v (select (i32.add (local.get $m) (i32.const 8)) (global.get $NULL_NODE) (local.get $m)))
    (if (call $is_composite (i32.load (local.get $v))) (then (call $fail (i32.const 44) (i32.const 0)) (return)))
    (call $o_scalar_at (local.get $v))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $o_byte (i32.const 0x0A)))

;; "GCF profile=generic" (+ " tool=..." when non-empty)
(func $o_generic_header (param $node i32)
  (local $p i32) (local $n i32)
  (call $o_bytes (global.get $S_GENHDR) (i32.const 19))
  (call $str_or_empty (local.get $node) (global.get $K_tool) (global.get $K_tool_n)) (local.set $n) (local.set $p)
  (if (local.get $n) (then (call $o_kv (global.get $K_tool) (global.get $K_tool_n)) (call $o_bytes (local.get $p) (local.get $n)))))

;; ---------------------------------------------------------------------------
;; Full payload and delta payload
;; ---------------------------------------------------------------------------

;; {set:{name?,key,fields,rows}, tool?} -> delta-participating full payload.
(func $encode_generic_full (param $input i32)
  (local $set i32) (local $kp i32) (local $kn i32) (local $fields i32) (local $nf i32) (local $rows i32) (local $nr i32)
  (local $np i32) (local $nn i32) (local $rp i32) (local $rn i32) (local $i i32)
  (local.set $set (call $get (local.get $input) (global.get $K_set) (global.get $K_set_n)))
  (if (i32.eqz (local.get $set)) (then (local.set $set (local.get $input))))
  (call $str_or_empty (local.get $set) (global.get $K_key) (global.get $K_key_n)) (local.set $kn) (local.set $kp)
  (call $field_list (call $get (local.get $set) (global.get $K_fields) (global.get $K_fields_n))) (local.set $nf) (local.set $fields)
  (if (global.get $err) (then (return)))
  (call $array_of (call $get (local.get $set) (global.get $K_rows) (global.get $K_rows_n))) (local.set $nr) (local.set $rows)
  (call $str_or_empty (local.get $set) (global.get $K_name) (global.get $K_name_n)) (local.set $nn) (local.set $np)
  (if (i32.eqz (local.get $nn)) (then (local.set $np (global.get $K_rows)) (local.set $nn (global.get $K_rows_n))))
  (call $generic_pack_root_fields (local.get $rows) (local.get $nr) (local.get $fields) (local.get $nf)) (local.set $rn) (local.set $rp)
  (if (global.get $err) (then (return)))
  (call $o_generic_header (local.get $input))
  (call $o_kv (global.get $K_pack_root) (global.get $K_pack_root_n)) (call $o_bytes (local.get $rp) (local.get $rn))
  (call $o_kv (global.get $K_key) (global.get $K_key_n)) (call $o_bytes (local.get $kp) (local.get $kn))
  (call $o_byte (i32.const 0x0A))
  (call $o_bytes (global.get $S_SECTION) (i32.const 3))
  (call $o_key (local.get $np) (local.get $nn))
  (call $o_bytes (global.get $S_SPBR) (i32.const 2))
  (call $o_u32 (local.get $nr))
  (call $o_bytes (global.get $S_TAB) (i32.const 2))
  (call $o_field_decl (local.get $fields) (local.get $nf) (local.get $kp) (local.get $kn))
  (call $o_bytes (global.get $S_HDREND) (i32.const 2))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nr)))
    (call $o_delta_row (i32.add (local.get $rows) (i32.shl (local.get $i) (i32.const 4))) (local.get $fields) (local.get $nf))
    (if (global.get $err) (then (return)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l))))

;; {tool?, key, fields, baseRoot, newRoot, added, changed, removed,
;;  deltaTokens?, fullTokens?} -> delta payload (SPEC §10a.2).
(func $encode_generic_delta (param $d i32)
  (local $kp i32) (local $kn i32) (local $fields i32) (local $nf i32) (local $full f64) (local $k i32) (local $rows i32) (local $nr i32)
  (local $i i32) (local $sp i32) (local $sn i32) (local $v i32)
  (call $str_or_empty (local.get $d) (global.get $K_key) (global.get $K_key_n)) (local.set $kn) (local.set $kp)
  (call $field_list (call $get (local.get $d) (global.get $K_fields) (global.get $K_fields_n))) (local.set $nf) (local.set $fields)
  (if (global.get $err) (then (return)))
  (call $o_generic_header (local.get $d))
  (call $o_kv (global.get $K_delta) (global.get $K_delta_n)) (call $o_bytes (global.get $S_TRUE) (i32.const 4))
  (call $o_kv (global.get $K_base_root) (global.get $K_base_root_n)) (call $o_member_str (local.get $d) (global.get $K_baseRoot) (global.get $K_baseRoot_n))
  (call $o_kv (global.get $K_new_root) (global.get $K_new_root_n)) (call $o_member_str (local.get $d) (global.get $K_newRoot) (global.get $K_newRoot_n))
  (call $o_kv (global.get $K_key) (global.get $K_key_n)) (call $o_bytes (local.get $kp) (local.get $kn))
  (local.set $full (call $num_of (call $get (local.get $d) (global.get $K_fullTokens) (global.get $K_fullTokens_n))))
  (if (f64.gt (local.get $full) (f64.const 0))
    (then
      (call $o_kv (global.get $K_savings) (global.get $K_savings_n))
      (call $o_i64 (call $savings (call $num_of (call $get (local.get $d) (global.get $K_deltaTokens) (global.get $K_deltaTokens_n))) (local.get $full)))
      (call $o_byte (i32.const 0x25))))
  (call $o_byte (i32.const 0x0A))
  (block $kd (loop $kl
    (br_if $kd (i32.ge_u (local.get $k) (i32.const 2)))
    (if (local.get $k)
      (then (local.set $sp (global.get $K_changed)) (local.set $sn (global.get $K_changed_n)))
      (else (local.set $sp (global.get $K_added)) (local.set $sn (global.get $K_added_n))))
    (local.set $k (i32.add (local.get $k) (i32.const 1)))
    (call $array_of (call $get (local.get $d) (local.get $sp) (local.get $sn))) (local.set $nr) (local.set $rows)
    (br_if $kl (i32.eqz (local.get $nr)))
    (call $o_bytes (global.get $S_SECTION) (i32.const 3))
    (call $o_bytes (local.get $sp) (local.get $sn))
    (call $o_bytes (global.get $S_SPBR) (i32.const 2))
    (call $o_u32 (local.get $nr))
    (call $o_bytes (global.get $S_TAB) (i32.const 2))
    (call $o_field_decl (local.get $fields) (local.get $nf) (local.get $kp) (local.get $kn))
    (call $o_bytes (global.get $S_HDREND) (i32.const 2))
    (local.set $i (i32.const 0))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $nr)))
      (call $o_delta_row (i32.add (local.get $rows) (i32.shl (local.get $i) (i32.const 4))) (local.get $fields) (local.get $nf))
      (if (global.get $err) (then (return)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (br $kl)))
  (call $array_of (call $get (local.get $d) (global.get $K_removed) (global.get $K_removed_n))) (local.set $nr) (local.set $rows)
  (if (local.get $nr)
    (then
      (call $o_bytes (global.get $S_SECTION) (i32.const 3))
      (call $o_bytes (global.get $K_removed) (global.get $K_removed_n))
      (call $o_bytes (global.get $S_SPBR) (i32.const 2))
      (call $o_u32 (local.get $nr))
      (call $o_bytes (global.get $S_TAB) (i32.const 2))
      (call $o_byte (i32.const 0x40))
      (call $o_key (local.get $kp) (local.get $kn))
      (call $o_bytes (global.get $S_HDREND) (i32.const 2))
      (local.set $i (i32.const 0))
      (block $done (loop $l
        (br_if $done (i32.ge_u (local.get $i) (local.get $nr)))
        (local.set $v (i32.add (local.get $rows) (i32.shl (local.get $i) (i32.const 4))))
        (if (call $is_composite (i32.load (local.get $v))) (then (call $fail (i32.const 44) (i32.const 0)) (return)))
        (call $o_scalar_at (local.get $v))
        (call $o_byte (i32.const 0x0A))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $l))))))

;; ---------------------------------------------------------------------------
;; Keyed diff (producer path behind §10a.2)
;; ---------------------------------------------------------------------------

;; Index rows by canonical identity: a 12-byte record per row (id ptr, id
;; len, row node) in input order plus a string map id -> record index.
;; Duplicate identities are duplicate_key. Returns (records, map).
(func $index_rows (param $rows i32) (param $n i32) (param $kp i32) (param $kn i32) (result i32 i32)
  (local $recs i32) (local $map i32) (local $i i32) (local $r i32) (local $v i32) (local $ip i32) (local $in i32) (local $q i32)
  (local.set $recs (call $alloc (i32.mul (local.get $n) (i32.const 12))))
  (local.set $map (call $ks_new))
  (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $r (i32.add (local.get $rows) (i32.shl (local.get $i) (i32.const 4))))
    (local.set $v (call $get (local.get $r) (local.get $kp) (local.get $kn)))
    (if (i32.eqz (local.get $v)) (then (local.set $v (global.get $NULL_NODE))))
    (call $render (local.get $v) (i32.const 2)) (local.set $in) (local.set $ip)
    (if (global.get $err) (then (return (i32.const 0) (i32.const 0))))
    (if (i32.ge_s (call $sm_find (local.get $map) (local.get $ip) (local.get $in) (i32.const 1) (local.get $i)) (i32.const 0))
      (then (call $fail (i32.const 15) (i32.const 0)) (return (i32.const 0) (i32.const 0))))
    (local.set $q (i32.add (local.get $recs) (i32.mul (local.get $i) (i32.const 12))))
    (i32.store (local.get $q) (local.get $ip))
    (i32.store offset=4 (local.get $q) (local.get $in))
    (i32.store offset=8 (local.get $q) (local.get $r))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $recs) (local.get $map))

;; Do two rows agree on every field (canonical cells; absent = null)?
(func $rows_equal (param $x i32) (param $y i32) (param $fields i32) (param $nf i32) (result i32)
  (local $i i32) (local $f i32) (local $a i32) (local $b i32) (local $ap i32) (local $an i32) (local $bp i32) (local $bn i32)
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nf)))
    (local.set $f (i32.add (local.get $fields) (i32.shl (local.get $i) (i32.const 3))))
    (local.set $a (call $get (local.get $x) (i32.load (local.get $f)) (i32.load offset=4 (local.get $f))))
    (local.set $b (call $get (local.get $y) (i32.load (local.get $f)) (i32.load offset=4 (local.get $f))))
    (call $render (select (local.get $a) (global.get $NULL_NODE) (local.get $a)) (i32.const 2)) (local.set $an) (local.set $ap)
    (call $render (select (local.get $b) (global.get $NULL_NODE) (local.get $b)) (i32.const 2)) (local.set $bn) (local.set $bp)
    (if (global.get $err) (then (return (i32.const 0))))
    (if (i32.eqz (call $str_eq (local.get $ap) (local.get $an) (local.get $bp) (local.get $bn))) (then (return (i32.const 0))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (i32.const 1))

;; Nodes of a sorted (id, node) 12-byte record list -> array of nodes.
(func $records_to_array (param $recs i32) (param $n i32) (result i32)
  (local $out i32) (local $i i32)
  (local.set $out (call $alloc (i32.shl (local.get $n) (i32.const 4))))
  (if (global.get $err) (then (return (i32.const 0))))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (v128.store (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 4)))
      (v128.load (i32.load offset=8 (i32.add (local.get $recs) (i32.mul (local.get $i) (i32.const 12))))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.get $out))

;; {base:{key,fields,rows}, next:{key,fields,rows}, tool?, deltaTokens?, fullTokens?}
(func $diff_and_encode (param $input i32)
  (local $base i32) (local $next i32) (local $kp i32) (local $kn i32) (local $bk i32) (local $bkn i32) (local $bf i32) (local $nbf i32) (local $nf i32) (local $nnf i32)
  (local $brows i32) (local $nb i32) (local $nrows i32) (local $nn i32) (local $brec i32) (local $bmap i32) (local $nrec i32) (local $nmap i32)
  (local $added i32) (local $na i32) (local $changed i32) (local $nc i32) (local $removed i32) (local $nr i32) (local $i i32) (local $q i32) (local $idx i32)
  (local $dst i32) (local $v i32) (local $mark i32) (local $p i32) (local $n i32) (local $t i32) (local $vt i32) (local $va i32) (local $vb i64) (local $node i32)
  (local.set $base (call $get (local.get $input) (global.get $K_base) (global.get $K_base_n)))
  (if (i32.eqz (local.get $base)) (then (call $fail (i32.const 43) (i32.const 0)) (return)))
  (local.set $next (call $get (local.get $input) (global.get $K_next) (global.get $K_next_n)))
  (if (i32.eqz (local.get $next)) (then (call $fail (i32.const 43) (i32.const 0)) (return)))
  (call $str_or_empty (local.get $next) (global.get $K_key) (global.get $K_key_n)) (local.set $kn) (local.set $kp)
  (if (i32.eqz (local.get $kn)) (then (call $fail_msg (i32.const 44) (i32.const 0) (i32.const 81)) (return)))
  (call $field_list (call $get (local.get $base) (global.get $K_fields) (global.get $K_fields_n))) (local.set $nbf) (local.set $bf)
  (if (global.get $err) (then (return)))
  (call $field_list (call $get (local.get $next) (global.get $K_fields) (global.get $K_fields_n))) (local.set $nnf) (local.set $nf)
  (if (global.get $err) (then (return)))
  (call $str_or_empty (local.get $base) (global.get $K_key) (global.get $K_key_n)) (local.set $bkn) (local.set $bk)
  (if (i32.or (i32.eqz (call $str_eq (local.get $kp) (local.get $kn) (local.get $bk) (local.get $bkn)))
              (i32.eqz (call $same_strings (local.get $bf) (local.get $nbf) (local.get $nf) (local.get $nnf))))
    (then (call $fail_msg (i32.const 44) (i32.const 0) (i32.const 82)) (return)))
  (call $array_of (call $get (local.get $base) (global.get $K_rows) (global.get $K_rows_n))) (local.set $nb) (local.set $brows)
  (call $array_of (call $get (local.get $next) (global.get $K_rows) (global.get $K_rows_n))) (local.set $nn) (local.set $nrows)
  (call $index_rows (local.get $brows) (local.get $nb) (local.get $kp) (local.get $kn)) (local.set $bmap) (local.set $brec)
  (if (global.get $err) (then (return)))
  (call $index_rows (local.get $nrows) (local.get $nn) (local.get $kp) (local.get $kn)) (local.set $nmap) (local.set $nrec)
  (if (global.get $err) (then (return)))
  (local.set $added (call $alloc (i32.mul (local.get $nn) (i32.const 12))))
  (local.set $changed (call $alloc (i32.mul (local.get $nn) (i32.const 12))))
  (local.set $removed (call $alloc (i32.mul (local.get $nb) (i32.const 12))))
  (if (global.get $err) (then (return)))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nn)))
    (local.set $q (i32.add (local.get $nrec) (i32.mul (local.get $i) (i32.const 12))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (local.set $idx (call $sm_find (local.get $bmap) (i32.load (local.get $q)) (i32.load offset=4 (local.get $q)) (i32.const 0) (i32.const 0)))
    (if (i32.lt_s (local.get $idx) (i32.const 0))
      (then
        (memory.copy (i32.add (local.get $added) (i32.mul (local.get $na) (i32.const 12))) (local.get $q) (i32.const 12))
        (local.set $na (i32.add (local.get $na) (i32.const 1)))
        (br $l)))
    (local.set $t (call $rows_equal (i32.load offset=8 (i32.add (local.get $brec) (i32.mul (local.get $idx) (i32.const 12)))) (i32.load offset=8 (local.get $q)) (local.get $nf) (local.get $nnf)))
    (if (global.get $err) (then (return)))
    (if (i32.eqz (local.get $t))
      (then
        (memory.copy (i32.add (local.get $changed) (i32.mul (local.get $nc) (i32.const 12))) (local.get $q) (i32.const 12))
        (local.set $nc (i32.add (local.get $nc) (i32.const 1)))))
    (br $l)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nb)))
    (local.set $q (i32.add (local.get $brec) (i32.mul (local.get $i) (i32.const 12))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br_if $l (i32.ge_s (call $sm_find (local.get $nmap) (i32.load (local.get $q)) (i32.load offset=4 (local.get $q)) (i32.const 0) (i32.const 0)) (i32.const 0)))
    ;; removed: the identity value (absent -> null)
    (local.set $dst (i32.add (local.get $removed) (i32.mul (local.get $nr) (i32.const 12))))
    (i32.store (local.get $dst) (i32.load (local.get $q)))
    (i32.store offset=4 (local.get $dst) (i32.load offset=4 (local.get $q)))
    (local.set $v (call $get (i32.load offset=8 (local.get $q)) (local.get $kp) (local.get $kn)))
    (i32.store offset=8 (local.get $dst) (select (local.get $v) (global.get $NULL_NODE) (local.get $v)))
    (local.set $nr (i32.add (local.get $nr) (i32.const 1)))
    (br $l)))
  (call $sort_records (local.get $added) (local.get $na) (i32.const 12) (i32.const 0))
  (call $sort_records (local.get $changed) (local.get $nc) (i32.const 12) (i32.const 0))
  (call $sort_records (local.get $removed) (local.get $nr) (i32.const 12) (i32.const 0))
  (if (global.get $err) (then (return)))
  ;; build the delta value and encode it
  (local.set $mark (call $obj_begin))
  (local.set $v (call $get (local.get $input) (global.get $K_tool) (global.get $K_tool_n)))
  (if (local.get $v) (then (call $obj_add (global.get $K_tool) (global.get $K_tool_n) (i32.load (local.get $v)) (i32.load offset=4 (local.get $v)) (i64.load offset=8 (local.get $v)))))
  (call $obj_add_str (global.get $K_key) (global.get $K_key_n) (local.get $kp) (local.get $kn))
  (local.set $v (call $get (local.get $next) (global.get $K_fields) (global.get $K_fields_n)))
  (call $obj_add (global.get $K_fields) (global.get $K_fields_n) (i32.load (local.get $v)) (i32.load offset=4 (local.get $v)) (i64.load offset=8 (local.get $v)))
  (call $generic_pack_root_fields (local.get $brows) (local.get $nb) (local.get $bf) (local.get $nbf)) (local.set $n) (local.set $p)
  (if (global.get $err) (then (return)))
  (call $obj_add_str (global.get $K_baseRoot) (global.get $K_baseRoot_n) (local.get $p) (local.get $n))
  (call $generic_pack_root_fields (local.get $nrows) (local.get $nn) (local.get $nf) (local.get $nnf)) (local.set $n) (local.set $p)
  (if (global.get $err) (then (return)))
  (call $obj_add_str (global.get $K_newRoot) (global.get $K_newRoot_n) (local.get $p) (local.get $n))
  (call $obj_add (global.get $K_added) (global.get $K_added_n) (i32.const 6) (call $records_to_array (local.get $added) (local.get $na)) (i64.extend_i32_u (local.get $na)))
  (call $obj_add (global.get $K_changed) (global.get $K_changed_n) (i32.const 6) (call $records_to_array (local.get $changed) (local.get $nc)) (i64.extend_i32_u (local.get $nc)))
  (call $obj_add (global.get $K_removed) (global.get $K_removed_n) (i32.const 6) (call $records_to_array (local.get $removed) (local.get $nr)) (i64.extend_i32_u (local.get $nr)))
  (local.set $v (call $get (local.get $input) (global.get $K_deltaTokens) (global.get $K_deltaTokens_n)))
  (if (local.get $v) (then (call $obj_add (global.get $K_deltaTokens) (global.get $K_deltaTokens_n) (i32.load (local.get $v)) (i32.load offset=4 (local.get $v)) (i64.load offset=8 (local.get $v)))))
  (local.set $v (call $get (local.get $input) (global.get $K_fullTokens) (global.get $K_fullTokens_n)))
  (if (local.get $v) (then (call $obj_add (global.get $K_fullTokens) (global.get $K_fullTokens_n) (i32.load (local.get $v)) (i32.load offset=4 (local.get $v)) (i64.load offset=8 (local.get $v)))))
  (call $obj_end (local.get $mark)) (local.set $vb) (local.set $va) (local.set $vt)
  (if (global.get $err) (then (return)))
  (local.set $node (call $alloc (i32.const 16)))
  (if (global.get $err) (then (return)))
  (call $store_node (local.get $node) (local.get $vt) (local.get $va) (local.get $vb))
  (call $encode_generic_delta (local.get $node)))

;; ---------------------------------------------------------------------------
;; Value grouping (SPEC §7.4.8, opt-in): {data, keyField, groupField}
;; ---------------------------------------------------------------------------

(func $encode_grouped (param $input i32)
  (local $data i32) (local $arr i32) (local $n i32) (local $kp i32) (local $kn i32) (local $gp i32) (local $gn i32) (local $fields i32) (local $nf i32)
  (local $i i32) (local $j i32) (local $item i32) (local $f i32) (local $hk i32) (local $hg i32) (local $m i32) (local $mn i32) (local $seen i32)
  (local $p i32) (local $len i32) (local $isc i32) (local $cval i32) (local $ok i32) (local $first i32) (local $fln i32)
  (local $gmap i32) (local $gidx i32) (local $ng i32) (local $graw i32) (local $counts i32) (local $starts i32) (local $order i32) (local $g i32) (local $v i32) (local $firstcell i32)
  (local.set $data (call $get (local.get $input) (global.get $K_data) (global.get $K_data_n)))
  (if (i32.eqz (local.get $data)) (then (call $fail (i32.const 43) (i32.const 0)) (return)))
  (call $str_or_empty (local.get $input) (global.get $K_keyField) (global.get $K_keyField_n)) (local.set $kn) (local.set $kp)
  (call $str_or_empty (local.get $input) (global.get $K_groupField) (global.get $K_groupField_n)) (local.set $gn) (local.set $gp)
  (if (i32.or (i32.ne (i32.load (local.get $data)) (i32.const 6)) (i32.eqz (i32.load offset=8 (local.get $data))))
    (then (call $fail (i32.const 44) (i32.const 0)) (return)))
  (if (call $str_eq (local.get $kp) (local.get $kn) (local.get $gp) (local.get $gn)) (then (call $fail (i32.const 44) (i32.const 0)) (return)))
  (local.set $arr (i32.load offset=4 (local.get $data)))
  (local.set $n (i32.load offset=8 (local.get $data)))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (if (i32.ne (i32.load (i32.add (local.get $arr) (i32.shl (local.get $i) (i32.const 4)))) (i32.const 7)) (then (call $fail (i32.const 44) (i32.const 0)) (return)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $tabular_fields (local.get $arr) (local.get $n)) (local.set $nf) (local.set $fields)
  (if (global.get $err) (then (return)))
  (if (i32.eqz (local.get $nf)) (then (call $fail (i32.const 44) (i32.const 0)) (return)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $nf)))
    (local.set $f (i32.add (local.get $fields) (i32.shl (local.get $i) (i32.const 3))))
    (if (call $str_eq (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)) (local.get $kp) (local.get $kn)) (then (local.set $hk (i32.const 1))))
    (if (call $str_eq (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)) (local.get $gp) (local.get $gn)) (then (local.set $hg (i32.const 1))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (if (i32.eqz (local.get $hk)) (then (call $fail (i32.const 44) (i32.const 0)) (return)))
  (if (i32.eqz (local.get $hg)) (then (call $fail (i32.const 44) (i32.const 0)) (return)))
  ;; scalar values only; the key present, non-null and unique
  (local.set $seen (call $ks_new))
  (if (global.get $err) (then (return)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $item (i32.add (local.get $arr) (i32.shl (local.get $i) (i32.const 4))))
    (local.set $mn (i32.load offset=8 (local.get $item)))
    (local.set $j (i32.const 0))
    (block $jd (loop $jl
      (br_if $jd (i32.ge_u (local.get $j) (local.get $mn)))
      (if (call $is_composite (i32.load offset=8 (i32.add (i32.load offset=4 (local.get $item)) (i32.mul (local.get $j) (i32.const 24)))))
        (then (call $fail (i32.const 44) (i32.const 0)) (return)))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $jl)))
    (local.set $m (call $field_of (local.get $item) (local.get $kp) (local.get $kn) (i32.const 0)))
    (if (i32.eqz (local.get $m)) (then (call $fail (i32.const 44) (i32.const 0)) (return)))
    (if (i32.eqz (i32.load offset=8 (local.get $m))) (then (call $fail (i32.const 44) (i32.const 0)) (return)))
    (call $render (i32.add (local.get $m) (i32.const 8)) (i32.const 0)) (local.set $len) (local.set $p)
    (if (call $ks_insert (local.get $seen) (local.get $p) (local.get $len)) (then (call $fail (i32.const 44) (i32.const 0)) (return)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  ;; constant columns (excluding key and group)
  (local.set $isc (call $alloc (local.get $nf)))
  (local.set $cval (call $alloc (i32.shl (local.get $nf) (i32.const 2))))
  (if (global.get $err) (then (return)))
  (memory.fill (local.get $isc) (i32.const 0) (local.get $nf))
  (if (i32.ge_u (local.get $n) (i32.const 2))
    (then
      (local.set $j (i32.const 0))
      (block $jd (loop $jl
        (br_if $jd (i32.ge_u (local.get $j) (local.get $nf)))
        (local.set $f (i32.add (local.get $fields) (i32.shl (local.get $j) (i32.const 3))))
        (block $skip
          (br_if $skip (call $str_eq (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)) (local.get $kp) (local.get $kn)))
          (br_if $skip (call $str_eq (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)) (local.get $gp) (local.get $gn)))
          (local.set $ok (i32.const 1))
          (local.set $i (i32.const 0))
          (block $id (loop $il
            (br_if $id (i32.ge_u (local.get $i) (local.get $n)))
            (local.set $m (call $field_of (i32.add (local.get $arr) (i32.shl (local.get $i) (i32.const 4))) (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)) (local.get $j)))
            (if (i32.eqz (local.get $m)) (then (local.set $ok (i32.const 0)) (br $id)))
            (call $render (i32.add (local.get $m) (i32.const 8)) (i32.const 1)) (local.set $len) (local.set $p)
            (if (i32.eqz (local.get $i))
              (then (local.set $first (local.get $p)) (local.set $fln (local.get $len))
                    (i32.store (i32.add (local.get $cval) (i32.shl (local.get $j) (i32.const 2))) (i32.add (local.get $m) (i32.const 8))))
              (else (if (i32.eqz (call $str_eq (local.get $first) (local.get $fln) (local.get $p) (local.get $len)))
                (then (local.set $ok (i32.const 0)) (br $id)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $il)))
          (i32.store8 (i32.add (local.get $isc) (local.get $j)) (local.get $ok)))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $jl)))))
  (if (global.get $err) (then (return)))
  ;; header
  (call $o_bytes (global.get $S_GENHDR) (i32.const 20))
  (call $o_bytes (global.get $S_HDRARR) (i32.const 4))
  (call $o_u32 (local.get $n))
  (call $o_bytes (global.get $S_TAB) (i32.const 2))
  (local.set $j (i32.const 0))
  (block $jd (loop $jl
    (br_if $jd (i32.ge_u (local.get $j) (local.get $nf)))
    (local.set $f (i32.add (local.get $fields) (i32.shl (local.get $j) (i32.const 3))))
    (if (local.get $j) (then (call $o_byte (i32.const 0x2C))))
    (if (call $str_eq (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)) (local.get $kp) (local.get $kn))
      (then (call $o_byte (i32.const 0x40)) (call $o_key (i32.load (local.get $f)) (i32.load offset=4 (local.get $f))))
      (else
        (call $o_key (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)))
        (if (call $at (local.get $isc) (local.get $j))
          (then (call $o_byte (i32.const 0x3D)) (call $o_const_value (i32.load (i32.add (local.get $cval) (i32.shl (local.get $j) (i32.const 2)))))))))
    (local.set $j (i32.add (local.get $j) (i32.const 1)))
    (br $jl)))
  (call $o_byte (i32.const 0x7D))
  (call $o_bytes (global.get $S_GROUP) (i32.const 7))
  (call $o_key (local.get $gp) (local.get $gn))
  (call $o_byte (i32.const 0x0A))
  ;; groups in first-seen order of the canonical group value (counting sort)
  (local.set $gmap (call $ks_new))
  (local.set $gidx (call $alloc (i32.shl (local.get $n) (i32.const 2))))
  (local.set $graw (call $alloc (i32.shl (local.get $n) (i32.const 2))))
  (if (global.get $err) (then (return)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $m (call $field_of (i32.add (local.get $arr) (i32.shl (local.get $i) (i32.const 4))) (local.get $gp) (local.get $gn) (i32.const 0)))
    (local.set $v (select (i32.add (local.get $m) (i32.const 8)) (global.get $NULL_NODE) (local.get $m)))
    (call $render (local.get $v) (i32.const 0)) (local.set $len) (local.set $p)
    (local.set $g (call $sm_find (local.get $gmap) (local.get $p) (local.get $len) (i32.const 1) (local.get $ng)))
    (if (i32.lt_s (local.get $g) (i32.const 0))
      (then
        (local.set $g (local.get $ng))
        (i32.store (i32.add (local.get $graw) (i32.shl (local.get $g) (i32.const 2))) (local.get $v))
        (local.set $ng (i32.add (local.get $ng) (i32.const 1)))))
    (i32.store (i32.add (local.get $gidx) (i32.shl (local.get $i) (i32.const 2))) (local.get $g))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.set $counts (call $alloc (i32.shl (i32.add (local.get $ng) (i32.const 1)) (i32.const 2))))
  (local.set $order (call $alloc (i32.shl (local.get $n) (i32.const 2))))
  (if (global.get $err) (then (return)))
  (memory.fill (local.get $counts) (i32.const 0) (i32.shl (i32.add (local.get $ng) (i32.const 1)) (i32.const 2)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $p (i32.add (local.get $counts) (i32.shl (i32.add (i32.load (i32.add (local.get $gidx) (i32.shl (local.get $i) (i32.const 2)))) (i32.const 1)) (i32.const 2))))
    (i32.store (local.get $p) (i32.add (i32.load (local.get $p)) (i32.const 1)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  ;; counts[g+1] = size of g -> prefix sums: counts[g] = start of g
  (local.set $g (i32.const 1))
  (block $done (loop $l
    (br_if $done (i32.gt_u (local.get $g) (local.get $ng)))
    (i32.store (i32.add (local.get $counts) (i32.shl (local.get $g) (i32.const 2)))
      (i32.add (i32.load (i32.add (local.get $counts) (i32.shl (local.get $g) (i32.const 2))))
               (i32.load (i32.add (local.get $counts) (i32.shl (i32.sub (local.get $g) (i32.const 1)) (i32.const 2))))))
    (local.set $g (i32.add (local.get $g) (i32.const 1)))
    (br $l)))
  (local.set $starts (call $dup (local.get $counts) (i32.shl (i32.add (local.get $ng) (i32.const 1)) (i32.const 2))))
  (if (global.get $err) (then (return)))
  (local.set $i (i32.const 0))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $p (i32.add (local.get $counts) (i32.shl (i32.load (i32.add (local.get $gidx) (i32.shl (local.get $i) (i32.const 2)))) (i32.const 2))))
    (i32.store (i32.add (local.get $order) (i32.shl (i32.load (local.get $p)) (i32.const 2))) (local.get $i))
    (i32.store (local.get $p) (i32.add (i32.load (local.get $p)) (i32.const 1)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (local.set $g (i32.const 0))
  (block $gd (loop $gl
    (br_if $gd (i32.ge_u (local.get $g) (local.get $ng)))
    (call $o_key (local.get $gp) (local.get $gn))
    (call $o_byte (i32.const 0x3D))
    (call $o_scalar_at (i32.load (i32.add (local.get $graw) (i32.shl (local.get $g) (i32.const 2)))))
    (call $o_bytes (global.get $S_SPBR) (i32.const 2))
    (call $o_u32 (i32.sub (i32.load (i32.add (local.get $starts) (i32.shl (i32.add (local.get $g) (i32.const 1)) (i32.const 2))))
                          (i32.load (i32.add (local.get $starts) (i32.shl (local.get $g) (i32.const 2))))))
    (call $o_bytes (global.get $S_CLOSE_NL) (i32.const 2))
    (local.set $i (i32.load (i32.add (local.get $starts) (i32.shl (local.get $g) (i32.const 2)))))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $i) (i32.load (i32.add (local.get $starts) (i32.shl (i32.add (local.get $g) (i32.const 1)) (i32.const 2))))))
      (local.set $item (i32.add (local.get $arr) (i32.shl (i32.load (i32.add (local.get $order) (i32.shl (local.get $i) (i32.const 2)))) (i32.const 4))))
      (local.set $firstcell (i32.const 1))
      (local.set $j (i32.const 0))
      (block $jd (loop $jl
        (br_if $jd (i32.ge_u (local.get $j) (local.get $nf)))
        (local.set $f (i32.add (local.get $fields) (i32.shl (local.get $j) (i32.const 3))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br_if $jl (call $str_eq (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)) (local.get $gp) (local.get $gn)))
        (br_if $jl (call $at (local.get $isc) (i32.sub (local.get $j) (i32.const 1))))
        (if (i32.eqz (local.get $firstcell)) (then (call $o_byte (i32.const 0x7C))))
        (local.set $firstcell (i32.const 0))
        (local.set $m (call $field_of (local.get $item) (i32.load (local.get $f)) (i32.load offset=4 (local.get $f)) (i32.sub (local.get $j) (i32.const 1))))
        (if (local.get $m) (then (call $o_scalar_at (i32.add (local.get $m) (i32.const 8)))) (else (call $o_byte (i32.const 0x7E))))
        (br $jl)))
      (call $o_byte (i32.const 0x0A))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $rl)))
    (local.set $g (i32.add (local.get $g) (i32.const 1)))
    (br $gl))))

;; ---------------------------------------------------------------------------
;; Exports
;; ---------------------------------------------------------------------------

(func (export "gcf_encode_generic_full") (param $len i32) (result i32)
  (local $in i32)
  (local.set $in (call $json_input_strict (local.get $len)))
  (if (global.get $err) (then (return (global.get $err))))
  (call $w_begin (i32.add (local.get $len) (i32.const 128)))
  (call $encode_generic_full (local.get $in))
  (call $finish_out))

(func (export "gcf_encode_generic_delta") (param $len i32) (result i32)
  (local $in i32)
  (local.set $in (call $json_input_strict (local.get $len)))
  (if (global.get $err) (then (return (global.get $err))))
  (call $w_begin (i32.add (local.get $len) (i32.const 128)))
  (call $encode_generic_delta (local.get $in))
  (call $finish_out))

(func (export "gcf_generic_diff") (param $len i32) (result i32)
  (local $in i32)
  (local.set $in (call $json_input_strict (local.get $len)))
  (if (global.get $err) (then (return (global.get $err))))
  (call $w_begin (i32.add (local.get $len) (i32.const 128)))
  (call $diff_and_encode (local.get $in))
  (call $finish_out))

(func (export "gcf_encode_grouped") (param $len i32) (result i32)
  (local $in i32)
  (local.set $in (call $json_input_strict (local.get $len)))
  (if (global.get $err) (then (return (global.get $err))))
  (call $w_begin (i32.add (local.get $len) (i32.const 128)))
  (call $encode_grouped (local.get $in))
  (call $finish_out))
